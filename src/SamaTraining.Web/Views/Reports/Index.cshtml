@model ReportViewModel
@{
    ViewData["Title"] = L["Reports"];
    var f = Model.Filter;
    var showMoney = (bool)ViewBag.ShowMoney;
    var showIncome = (bool)ViewBag.ShowIncome;
    var countries = AppOptions.Value.GetCountries();
    var maxMonth = Math.Max(1, Model.RegistrationsByMonth.Count == 0 ? 1 : Model.RegistrationsByMonth.Max(m => m.Count));
    var exportQuery = new Dictionary<string, string?>
    {
        ["From"] = f.From?.ToString("yyyy-MM-dd"),
        ["To"] = f.To?.ToString("yyyy-MM-dd"),
        ["Country"] = f.Country,
        ["Status"] = f.Status?.ToString()
    };
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-6">
    <div>
        <h4 class="mb-1">@L["Reports"]</h4>
        <p class="mb-0 text-body-secondary">@(f.From?.ToString("dd MMM yyyy")) – @(f.To?.ToString("dd MMM yyyy")) · @L["{0} workshops", Model.Rows.Count]</p>
    </div>
    <a asp-action="Export" asp-all-route-data="exportQuery" class="btn btn-outline-primary"><i class="icon-base ri ri-file-excel-2-line me-1"></i>@L["Export to Excel (CSV)"]</a>
</div>

<div class="card mb-6">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-4 align-items-end">
            <div class="col-6 col-md-3">
                <label class="form-label" for="From">@L["From"]</label>
                <input type="date" id="From" name="From" value="@(f.From?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label" for="To">@L["To"]</label>
                <input type="date" id="To" name="To" value="@(f.To?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label" for="Country">@L["Country"]</label>
                <select id="Country" name="Country" class="form-select">
                    <option value="">@L["All"]</option>
                    @foreach (var c in countries)
                    {
                        <!option value="@c.Code" selected="@(f.Country == c.Code)">@UiText.Pick(c.Name, c.NameAr) (@c.Currency)</!option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label" for="Status">@L["Status"]</label>
                <select id="Status" name="Status" class="form-select">
                    <option value="">@L["All"]</option>
                    @foreach (var s in Enum.GetValues<WorkshopStatus>())
                    {
                        <!option value="@s" selected="@(f.Status == s)">@UiText.Status(s)</!option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-primary" data-loading-text="@L["Updating…"]"><i class="icon-base ri ri-refresh-line me-1"></i>@L["Update"]</button>
            </div>
        </form>
    </div>
</div>

<!-- Headline numbers -->
<div class="row g-6 mb-6">
    <div class="col-sm-6 col-lg-3">
        <div class="card h-100"><div class="card-body">
            <span class="stat-icon bg-label-primary mb-3"><i class="icon-base ri ri-presentation-line"></i></span>
            <h4 class="mb-0">@Model.Rows.Count</h4>
            <p class="mb-0 text-body-secondary">@L["Workshops"]</p>
        </div></div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card h-100"><div class="card-body">
            <span class="stat-icon bg-label-info mb-3"><i class="icon-base ri ri-group-line"></i></span>
            <h4 class="mb-0">@Model.TotalRegistrations.ToString("N0")</h4>
            <p class="mb-0 text-body-secondary">@L["Student registrations"]</p>
        </div></div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card h-100"><div class="card-body">
            <span class="stat-icon bg-label-success mb-3"><i class="icon-base ri ri-checkbox-circle-line"></i></span>
            <h4 class="mb-0">@Model.Rows.Count(r => r.Status == WorkshopStatus.Completed)</h4>
            <p class="mb-0 text-body-secondary">@L["Completed"]</p>
        </div></div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card h-100"><div class="card-body">
            <span class="stat-icon bg-label-warning mb-3"><i class="icon-base ri ri-pie-chart-2-line"></i></span>
            <h4 class="mb-0">@(Model.AverageFill.HasValue ? Model.AverageFill + "%" : "—")</h4>
            <p class="mb-0 text-body-secondary">@L["Average seats filled"]</p>
        </div></div>
    </div>
</div>

@if ((showMoney || showIncome) && Model.Summaries.Count > 0)
{
    <h5 class="mb-3">@L["By currency"]</h5>
    <div class="row g-6 mb-6">
        @foreach (var s in Model.Summaries)
        {
            <div class="col-md-6">
                <div class="card h-100 report-currency-card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-4">
                            <div>
                                <span class="badge bg-label-primary mb-2">@s.Currency</span>
                                <h6 class="mb-0 text-body-secondary">@L[s.CountryName]</h6>
                            </div>
                            @if (showMoney && showIncome)
                            {
                                <div class="text-end">
                                    <div class="small text-body-secondary">@L["Net profit"]</div>
                                    <h4 class="mb-0 @(s.NetProfit < 0 ? "text-danger" : "text-success")">@MoneyFormat.Format(s.NetProfit, s.Currency)</h4>
                                </div>
                            }
                            else if (showMoney)
                            {
                                <div class="text-end">
                                    <div class="small text-body-secondary">@L["Total expenses"]</div>
                                    <h4 class="mb-0">@MoneyFormat.Format(s.Expenses, s.Currency)</h4>
                                </div>
                            }
                        </div>
                        <div class="fin-grid mb-4">
                            @if (showIncome)
                            {
                                <div class="fin-tile"><small>@L["Target (all seats)"]</small><strong>@s.TargetIncome.ToString("N2")</strong></div>
                                <div class="fin-tile"><small>@L["Expected income"]</small><strong>@s.ExpectedIncome.ToString("N2")</strong></div>
                                <div class="fin-tile"><small>@L["Collected"]</small><strong class="text-success">@s.Collected.ToString("N2")</strong></div>
                                <div class="fin-tile"><small>@L["Outstanding"]</small><strong class="text-warning">@s.Outstanding.ToString("N2")</strong></div>
                            }
                            @if (showMoney)
                            {
                                <div class="fin-tile"><small>@L["Total expenses"]</small><strong class="text-danger">@MoneyFormat.Format(s.Expenses, s.Currency)</strong></div>
                            }
                            @if (showMoney && showIncome)
                            {
                                <div class="fin-tile"><small>@L["Projected profit"]</small><strong class="@(s.ProjectedProfit < 0 ? "text-danger" : "text-success")">@s.ProjectedProfit.ToString("N2")</strong></div>
                            }
                        </div>
                        <div class="row text-center g-2">
                            <div class="col-4"><div class="report-mini"><strong>@s.Workshops</strong><span>@L["Workshops"]</span></div></div>
                            <div class="col-4"><div class="report-mini"><strong>@s.Registrations</strong><span>@L["Students"]</span></div></div>
                            <div class="col-4"><div class="report-mini"><strong>@(s.CostPerStudent.HasValue ? s.CostPerStudent.Value.ToString("N0") : "—")</strong><span>@L["Cost / student"]</span></div></div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<div class="row g-6 mb-6">
    <div class="@(showMoney ? "col-lg-7" : "col-12")">
        <div class="card">
            <div class="card-header"><h5 class="mb-0">@L["Registrations by month"]</h5></div>
            <div class="card-body">
                @if (Model.TotalRegistrations == 0)
                {
                    <p class="text-body-secondary mb-0">@L["No registrations in this period."]</p>
                }
                else
                {
                    <div class="month-bars">
                        @foreach (var m in Model.RegistrationsByMonth)
                        {
                            var h = (int)Math.Round(100.0 * m.Count / maxMonth);
                            <div class="month-bar" title="@m.Month.ToString("MMMM yyyy", DisplayFormat.Culture(UiText.Lang)): @m.Count">
                                <span class="month-value">@(m.Count > 0 ? m.Count.ToString() : "")</span>
                                <div class="month-fill" style="height: @(Math.Max(h, m.Count > 0 ? 4 : 0))%"></div>
                                <span class="month-label">@m.Month.ToString("MMM")</span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    @if (showMoney)
    {
        <div class="col-lg-5">
            <div class="card h-100">
                <div class="card-header"><h5 class="mb-0">@L["Expenses by category"]</h5></div>
                <div class="card-body">
                    @if (Model.CategoryBreakdowns.Count == 0)
                    {
                        <p class="text-body-secondary mb-0">@L["No expenses in this period."]</p>
                    }
                    @foreach (var b in Model.CategoryBreakdowns)
                    {
                        <div class="mb-5">
                            <div class="d-flex justify-content-between mb-3">
                                <span class="badge bg-label-primary">@b.Currency</span>
                                <span class="fw-medium">@MoneyFormat.Format(b.Total, b.Currency)</span>
                            </div>
                            @foreach (var c in b.Categories)
                            {
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between small mb-1">
                                        <span>@c.Category</span>
                                        <span class="text-body-secondary">@c.Amount.ToString("N2") · @c.Percent%</span>
                                    </div>
                                    <div class="progress" style="height: 6px">
                                        <div class="progress-bar" style="width: @c.Percent%"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

<div class="card">
    <div class="card-header"><h5 class="mb-0">@L["Workshop details"]</h5></div>
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
            <tr>
                <th>@L["Workshop"]</th>
                <th>@L["Country"]</th>
                <th>@L["Status"]</th>
                <th style="min-width: 160px">@L["Seats filled"]</th>
                @if (showIncome)
                {
                    <th class="text-end">@L["Target"]</th>
                    <th class="text-end">@L["Expected"]</th>
                    <th class="text-end">@L["Collected"]</th>
                    <th class="text-end">@L["Outstanding"]</th>
                }
                @if (showMoney)
                {
                    <th class="text-end">@L["Expenses"]</th>
                    <th class="text-end">@L["Cost / student"]</th>
                }
                @if (showMoney && showIncome)
                {
                    <th class="text-end">@L["Net profit"]</th>
                }
            </tr>
            </thead>
            <tbody class="table-border-bottom-0">
            @if (Model.Rows.Count == 0)
            {
                <tr><td colspan="10" class="text-center text-body-secondary py-6">@L["No workshops in this period."]</td></tr>
            }
            @foreach (var r in Model.Rows)
            {
                <tr>
                    <td>
                        <a asp-controller="Workshops" asp-action="Details" asp-route-id="@r.Id" class="fw-medium">@UiText.Pick(r.Name, r.NameAr)</a>
                        <small class="d-block text-body-secondary">@DisplayFormat.ShortDates(r.StartDateTime, r.EndDateTime) · @(r.Type == WorkshopType.Online ? L["Online"] : L["On-site"]) · @(r.Fee is > 0 ? MoneyFormat.Format(r.Fee.Value, r.Currency) : L["Free"])</small>
                    </td>
                    <td>@L[r.CountryName]</td>
                    <td><partial name="_StatusBadge" model="r.Status" /></td>
                    <td>
                        @if (r.FillPercent.HasValue)
                        {
                            <div class="d-flex align-items-center gap-2">
                                <div class="progress flex-grow-1" style="height: 6px">
                                    <div class="progress-bar @(r.FillPercent >= 90 ? "bg-success" : r.FillPercent < 40 ? "bg-warning" : "")" style="width: @Math.Min(100, r.FillPercent.Value)%"></div>
                                </div>
                                <small class="text-nowrap">@r.Registrations/@r.Capacity</small>
                            </div>
                        }
                        else
                        {
                            <small>@L["{0} participants", r.Registrations]</small>
                        }
                    </td>
                    @if (showIncome)
                    {
                        <td class="text-end text-nowrap text-body-secondary">@MoneyFormat.Format(r.TargetIncome, r.Currency)</td>
                        <td class="text-end text-nowrap">@MoneyFormat.Format(r.ExpectedIncome, r.Currency)</td>
                        <td class="text-end text-nowrap text-success">@MoneyFormat.Format(r.Collected, r.Currency)</td>
                        <td class="text-end text-nowrap">@MoneyFormat.Format(r.Outstanding, r.Currency)</td>
                    }
                    @if (showMoney)
                    {
                        <td class="text-end text-nowrap">@MoneyFormat.Format(r.Expenses, r.Currency)</td>
                        <td class="text-end text-nowrap">@(r.CostPerStudent.HasValue ? MoneyFormat.Format(r.CostPerStudent.Value, r.Currency) : "—")</td>
                    }
                    @if (showMoney && showIncome)
                    {
                        <td class="text-end text-nowrap fw-medium @(r.NetProfit < 0 ? "text-danger" : "")">@MoneyFormat.Format(r.NetProfit, r.Currency)</td>
                    }
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
