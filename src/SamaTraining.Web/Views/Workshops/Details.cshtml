@model WorkshopDetailsViewModel
@inject PhoneNumberService Phones
@{
    var w = Model.Workshop;
    ViewData["Title"] = w.Name;
    var currency = w.CurrencyCode;
    var countryName = L[AppOptions.Value.CountryName(w.Country)];
    var highlight = TempData["Highlight"] as string;
    var canSeeStudents = User.Can(Permissions.RegistrationsView);
    var canSeeExpenses = User.Can(Permissions.ExpensesView);
    var canSeeMoney = User.Can(Permissions.CollectionsView);
    var canCollect = User.Can(Permissions.CollectionsManage) && Model.CanCollect;
    var showPayments = canSeeMoney && !w.IsFree;
    var fin = Model.Finance;
    var tab = Model.Tab;
    if (tab == "registrations" && !canSeeStudents) tab = "overview";
    if (tab == "expenses" && !canSeeExpenses) tab = "overview";
    if (tab == "payments" && !showPayments) tab = "overview";
    string TabCss(string t) => tab == t ? "active" : "";
    string PaneCss(string t) => tab == t ? "show active" : "";
    var fill = w.Capacity is > 0 ? Math.Min(100, (int)Math.Round(100.0 * Model.RegistrationCount / w.Capacity.Value)) : (int?)null;
}

<a asp-action="Index" class="small d-inline-flex align-items-center mb-4"><i class="icon-base ri ri-arrow-left-line me-1"></i>@L["All workshops"]</a>

<!-- Hero -->
<div class="card ws-hero mb-6">
    <div class="ws-hero-top p-5 p-md-6">
        <div class="d-flex flex-wrap gap-4 align-items-start">
            <div class="ws-date-tile">
                <span class="m">@w.StartDateTime.ToString("MMM")</span>
                <span class="d">@(w.StartDateTime.Day)@(w.IsMultiDay ? "–" + (w.EndDateTime.Month == w.StartDateTime.Month ? w.EndDateTime.Day.ToString() : w.EndDateTime.ToString("d MMM")) : "")</span>
            </div>
            <div class="flex-grow-1" style="min-width: 220px">
                <div class="d-flex flex-wrap gap-2 mb-2">
                    <partial name="_StatusBadge" model="w.Status" />
                    @if (w.RegistrationOpen)
                    {
                        <span class="badge rounded-pill bg-label-primary"><i class="icon-base ri ri-door-open-line me-1"></i>@L["Registration open"]</span>
                    }
                    else
                    {
                        <span class="badge rounded-pill bg-label-secondary"><i class="icon-base ri ri-lock-line me-1"></i>@L["Registration closed"]</span>
                    }
                </div>
                <h4 class="mb-1">@UiText.Pick(w.Name, w.NameAr)</h4>
                @* The other language's name underneath *@
                @{ var otherName = UiText.IsArabic ? w.Name : w.NameAr; }
                @if (!string.IsNullOrWhiteSpace(otherName) && otherName != UiText.Pick(w.Name, w.NameAr))
                {
                    <div class="fw-medium text-body-secondary mb-1" dir="@(UiText.IsArabic ? "ltr" : "rtl")" style="text-align:start">@otherName</div>
                }
                @if (!string.IsNullOrWhiteSpace(w.Description))
                {
                    <p class="mb-0 text-body-secondary">@w.Description</p>
                }
            </div>
            <div class="d-flex gap-2">
                @if (Model.CanEdit && User.Can(Permissions.WorkshopsManage))
                {
                    <a asp-action="Edit" asp-route-id="@w.Id" class="btn btn-primary"><i class="icon-base ri ri-edit-box-line me-1"></i>@L["Edit"]</a>
                }
                @if (Model.CanDelete && User.Can(Permissions.WorkshopsDelete))
                {
                    <form asp-action="Delete" asp-route-id="@w.Id" method="post"
                          data-confirm="@L["\"{0}\" will be permanently deleted.", w.Name]" data-confirm-title="@L["Delete this workshop?"]" data-confirm-button="@L["Delete workshop"]">
                        <button type="submit" class="btn btn-outline-danger" data-loading-text="@L["Deleting…"]"><i class="icon-base ri ri-delete-bin-7-line me-1"></i>@L["Delete"]</button>
                    </form>
                }
            </div>
        </div>
    </div>
    <div class="card-body py-5">
        <div class="row g-5">
            <div class="col-sm-6 col-lg">
                <div class="ws-fact">
                    <span class="stat-icon bg-label-primary"><i class="icon-base ri ri-time-line"></i></span>
                    <div><small>@(w.IsMultiDay ? DisplayFormat.ShortDates(w.StartDateTime, w.EndDateTime) + " · " + L["{0} days", w.Days] : w.StartDateTime.ToString("dddd, dd MMM yyyy", DisplayFormat.Culture(UiText.Lang)))</small><strong>@DisplayFormat.Hours(w)@(w.IsMultiDay ? " " + L["daily"] : "")</strong></div>
                </div>
            </div>
            <div class="col-sm-6 col-lg">
                <div class="ws-fact">
                    <span class="stat-icon bg-label-info"><i class="icon-base ri @(w.Type == WorkshopType.Online ? "ri-global-line" : "ri-map-pin-line")"></i></span>
                    <div><small>@(w.Type == WorkshopType.Online ? L["Online"] : L["On-site"])</small><strong>@(w.Type == WorkshopType.Online ? L["Remote session"] : (w.Hall != null ? w.Hall.LocalName(UiText.Lang) : "—"))</strong></div>
                </div>
            </div>
            <div class="col-sm-6 col-lg">
                <div class="ws-fact">
                    <span class="stat-icon bg-label-warning"><i class="icon-base ri ri-flag-line"></i></span>
                    <div><small>@countryName · @currency</small><strong>@(w.IsFree ? L["Free"] : MoneyFormat.Format(w.Fee!.Value, currency))</strong></div>
                </div>
            </div>
            <div class="col-sm-6 col-lg">
                <div class="ws-fact">
                    <span class="stat-icon bg-label-success"><i class="icon-base ri ri-group-line"></i></span>
                    <div class="flex-grow-1">
                        <small>@L["Participants"]</small>
                        <strong>@(Model.RegistrationCount + (w.Capacity.HasValue ? " / " + w.Capacity : ""))</strong>
                        @if (fill.HasValue)
                        {
                            <div class="progress mt-1" style="height: 4px"><div class="progress-bar" style="width: @fill%"></div></div>
                        }
                    </div>
                </div>
            </div>
            @if (canSeeExpenses)
            {
                <div class="col-sm-6 col-lg">
                    <div class="ws-fact">
                        <span class="stat-icon bg-label-danger"><i class="icon-base ri ri-money-dollar-circle-line"></i></span>
                        <div><small>@L["Expenses"]</small><strong>@MoneyFormat.Format(Model.TotalExpenses, currency)</strong></div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<div class="row g-6">
    <!-- Tabs -->
    <div class="col-xl-8">
        <div class="card">
            <ul class="nav ws-tabs px-3" role="tablist">
                <li class="nav-item"><button type="button" class="nav-link @TabCss("overview")" data-bs-toggle="tab" data-bs-target="#tab-overview" data-tab-name="overview" role="tab"><i class="icon-base ri ri-file-list-3-line me-1"></i>@L["Overview"]</button></li>
                @if (canSeeStudents)
                {
                    <li class="nav-item"><button type="button" class="nav-link @TabCss("registrations")" data-bs-toggle="tab" data-bs-target="#tab-registrations" data-tab-name="registrations" role="tab"><i class="icon-base ri ri-group-line me-1"></i>@L["Students"] <span class="badge rounded-pill bg-label-primary ms-1">@Model.RegistrationCount</span></button></li>
                }
                @if (canSeeExpenses)
                {
                    <li class="nav-item"><button type="button" class="nav-link @TabCss("expenses")" data-bs-toggle="tab" data-bs-target="#tab-expenses" data-tab-name="expenses" role="tab"><i class="icon-base ri ri-wallet-3-line me-1"></i>@L["Expenses"] <span class="badge rounded-pill bg-label-secondary ms-1">@Model.Expenses.Count</span></button></li>
                }
                @if (showPayments)
                {
                    <li class="nav-item"><button type="button" class="nav-link @TabCss("payments")" data-bs-toggle="tab" data-bs-target="#tab-payments" data-tab-name="payments" role="tab"><i class="icon-base ri ri-hand-coin-line me-1"></i>@L["Payments"] <span class="badge rounded-pill bg-label-success ms-1">@Model.Collections.Count</span></button></li>
                }
                <li class="nav-item"><button type="button" class="nav-link @TabCss("history")" data-bs-toggle="tab" data-bs-target="#tab-history" data-tab-name="history" role="tab"><i class="icon-base ri ri-history-line me-1"></i>@L["History"]</button></li>
            </ul>

            <div class="tab-content p-0">
                <!-- Overview -->
                <div class="tab-pane fade @PaneCss("overview")" id="tab-overview" role="tabpanel">
                    <div class="card-body">
                        @if (string.IsNullOrWhiteSpace(w.Content) && string.IsNullOrWhiteSpace(w.ContentAr))
                        {
                            <div class="empty-state">
                                <span class="stat-icon bg-label-secondary"><i class="icon-base ri ri-file-text-line"></i></span>
                                <h6 class="mb-1">@L["No agenda yet"]</h6>
                                <p class="text-body-secondary small mb-0">@L["Add topics, trainer and requirements so students know what to expect."]</p>
                            </div>
                        }
                        else
                        {
                            @if (!string.IsNullOrWhiteSpace(w.Content))
                            {
                                <h6 class="text-body-secondary text-uppercase small mb-3">@L["Agenda (English)"]</h6>
                                <div class="rich-text" dir="ltr">@RichText.ToHtml(w.Content)</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(w.ContentAr))
                            {
                                <hr class="my-5" />
                                <h6 class="text-body-secondary small mb-3" dir="rtl">@L["المحاور (Arabic)"]</h6>
                                <div class="rich-text" dir="rtl">@RichText.ToHtml(w.ContentAr)</div>
                            }
                        }
                        @if (w.Type == WorkshopType.Online && !string.IsNullOrEmpty(w.MeetingLink))
                        {
                            <hr class="my-5" />
                            <h6 class="text-body-secondary text-uppercase small mb-2">@L["Meeting link"]</h6>
                            <a href="@w.MeetingLink" target="_blank" rel="noopener">@w.MeetingLink</a>
                        }
                        @if (w.Type == WorkshopType.OnSite && w.Hall?.Location != null)
                        {
                            <hr class="my-5" />
                            <h6 class="text-body-secondary text-uppercase small mb-2">@L["Location"]</h6>
                            <p class="mb-0">@w.Hall.LocalName(UiText.Lang) — @w.Hall.LocalLocation(UiText.Lang)</p>
                            @if (!string.IsNullOrWhiteSpace(w.Hall.NameAr) || !string.IsNullOrWhiteSpace(w.Hall.LocationAr))
                            {
                                <p class="mb-0 small text-body-secondary" dir="rtl">@w.Hall.LocalName("ar")@(string.IsNullOrWhiteSpace(w.Hall.LocationAr) ? "" : " — " + w.Hall.LocationAr)</p>
                            }
                        }
                    </div>
                </div>

                <!-- Students -->
                @if (canSeeStudents)
                {
                    <div class="tab-pane fade @PaneCss("registrations")" id="tab-registrations" role="tabpanel">
                        @if (Model.Registrations.Count == 0)
                        {
                            <div class="empty-state">
                                <span class="stat-icon bg-label-primary"><i class="icon-base ri ri-user-add-line"></i></span>
                                <h6 class="mb-1">@L["No students yet"]</h6>
                                <p class="text-body-secondary small mb-0">@(w.RegistrationOpen ? L["Share the registration link to start receiving applications."] : L["Open registration to get a link you can share with students."])</p>
                            </div>
                        }
                        else
                        {
                            var canCancel = User.Can(Permissions.RegistrationsCancel) && w.Status != WorkshopStatus.Completed;
                            @if (Model.OverCapacity)
                            {
                                <div class="alert alert-danger d-flex gap-3 align-items-start mx-5 mt-4 mb-0" role="alert">
                                    <i class="icon-base ri ri-error-warning-line icon-22px"></i>
                                    <div>
                                        <strong>@L["Over capacity: {0} participants for {1} seats.", Model.RegistrationCount, w.Capacity]</strong>
                                        <div class="small">@L["A cancellation was undone after the seat was taken. Increase the capacity (Edit) or cancel a registration."]</div>
                                    </div>
                                </div>
                            }
                            <div class="d-flex justify-content-between align-items-center px-5 pt-4 pb-2">
                                <span class="text-body-secondary small">@L["{0} registered", Model.RegistrationCount]@(Model.CancelledCount > 0 ? " · " + L["{0} cancelled", Model.CancelledCount] : "")</span>
                                <a asp-action="ExportRegistrations" asp-route-id="@w.Id" class="btn btn-sm btn-outline-primary"><i class="icon-base ri ri-download-2-line me-1"></i>@L["Export to Excel (CSV)"]</a>
                            </div>
                            <div class="table-responsive">
                                <table class="table">
                                    <thead><tr><th>@L["Participant"]</th><th>@L["Phone"]</th><th>@L["Organization"]</th><th>@L["Registered"]</th>@if (showPayments) { <th>@L["Payment"]</th> }@if (canCancel) { <th></th> }</tr></thead>
                                    <tbody class="table-border-bottom-0">
                                    @foreach (var r in Model.Registrations)
                                    {
                                        var hasPaid = Model.PaidRegistrationIds.Contains(r.Id);
                                        <tr class="@(r.IsCancelled ? "row-cancelled" : "") @(highlight == "r" + r.Id ? "row-highlight" : "")">
                                            <td>
                                                <div class="fw-medium text-heading">
                                                    @r.FullName
                                                    @if (r.Language == "ar") { <span class="badge bg-label-secondary ms-1">@L["AR"]</span> }
                                                    @if (r.IsCancelled) { <span class="badge bg-label-danger ms-1">@L["Cancelled"]</span> }
                                                </div>
                                                <small><a href="mailto:@r.Email">@r.Email</a></small>
                                                @if (r.IsCancelled)
                                                {
                                                    <small class="d-block text-body-secondary mt-1">@L["Cancelled {0} by {1}", r.CancelledAt?.ToLocalTime().ToString("dd MMM yyyy, HH:mm"), r.CancelledBy]@(string.IsNullOrEmpty(r.CancelReason) ? "" : " — " + r.CancelReason)</small>
                                                }
                                            </td>
                                            <td class="text-nowrap">
                                                <span dir="ltr">@Phones.Format(r.Phone)</span>
                                                @if (!r.IsCancelled && Model.EarlierWorkshopsByPhone.TryGetValue(r.Phone, out var earlier))
                                                {
                                                    <span class="badge bg-label-info d-block mt-1" title="@L["Same phone number registered for {0} other workshops", earlier]"><i class="icon-base ri ri-repeat-line me-1"></i>@L["Returning"] · @earlier</span>
                                                }
                                            </td>
                                            <td>@r.Organization</td>
                                            <td class="text-nowrap small">@r.RegisteredAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td>
                                            @if (showPayments)
                                            {
                                                if (r.IsCancelled)
                                                {
                                                    <td class="small text-body-secondary">@L["Not counted"]</td>
                                                }
                                                else
                                                {
                                                    var paid = Model.PaidByRegistration.GetValueOrDefault(r.Id);
                                                    var ps = FinanceService.StatusOf(w.Fee, paid);
                                                    <td class="text-nowrap">
                                                        <span class="badge @DisplayFormat.BadgeCss(ps)">@DisplayFormat.Label(ps)</span>
                                                        <small class="d-block text-body-secondary mt-1">@paid.ToString("N2") / @w.Fee!.Value.ToString("N2")</small>
                                                        @if (canCollect && ps != PaymentStatus.Paid)
                                                        {
                                                            <a asp-controller="Collections" asp-action="Create" asp-route-workshopId="@w.Id" asp-route-registrationId="@r.Id" class="small">@L["Record payment"]</a>
                                                        }
                                                    </td>
                                                }
                                            }
                                            @if (canCancel)
                                            {
                                                <td class="text-end text-nowrap">
                                                    @if (r.IsCancelled)
                                                    {
                                                        <form asp-action="RestoreRegistration" method="post" class="d-inline"
                                                              data-confirm="@L["{0} will be registered again and count toward seats and fees.", r.FullName]@(w.Capacity.HasValue && Model.RegistrationCount >= w.Capacity ? " " + L["All seats are taken, so the workshop will go over capacity and administrators will be alerted."] : "")"
                                                              data-confirm-title="@L["Undo this cancellation?"]" data-confirm-button="@L["Undo cancellation"]">
                                                            <input type="hidden" name="id" value="@w.Id" />
                                                            <input type="hidden" name="registrationId" value="@r.Id" />
                                                            <button type="submit" class="btn btn-sm btn-outline-secondary" data-loading-text="@L["Restoring…"]"><i class="icon-base ri ri-arrow-go-back-line me-1"></i>@L["Undo"]</button>
                                                        </form>
                                                    }
                                                    else if (hasPaid)
                                                    {
                                                        <span class="d-inline-block" tabindex="0" title="@L["Paid participants can't be cancelled"]">
                                                            <button type="button" class="btn btn-sm btn-text-secondary" disabled><i class="icon-base ri ri-user-forbid-line me-1"></i>@L["Cancel"]</button>
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <button type="button" class="btn btn-sm btn-text-danger" data-bs-toggle="modal" data-bs-target="#cancel-registration"
                                                                data-registration-id="@r.Id" data-registration-name="@r.FullName">
                                                            <i class="icon-base ri ri-user-forbid-line me-1"></i>@L["Cancel"]
                                                        </button>
                                                    }
                                                </td>
                                            }
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                }

                <!-- Expenses -->
                @if (canSeeExpenses)
                {
                    var canManage = User.Can(Permissions.ExpensesManage) && Model.CanAddExpense;
                    <div class="tab-pane fade @PaneCss("expenses")" id="tab-expenses" role="tabpanel">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 px-5 pt-4 pb-2">
                            <div>
                                <span class="text-body-secondary small">@L["Total"]</span>
                                <span class="fw-semibold text-heading ms-1">@MoneyFormat.Format(Model.TotalExpenses, currency)</span>
                            </div>
                            @if (canManage)
                            {
                                <a asp-controller="Expenses" asp-action="Create" asp-route-workshopId="@w.Id" class="btn btn-sm btn-primary"><i class="icon-base ri ri-add-line me-1"></i>@L["Add expense"]</a>
                            }
                            else if (!Model.CanAddExpense)
                            {
                                <span class="badge bg-label-secondary"><i class="icon-base ri ri-lock-line me-1"></i>@L["Finalised — workshop completed"]</span>
                            }
                        </div>
                        @if (Model.Expenses.Count == 0)
                        {
                            <div class="empty-state">
                                <span class="stat-icon bg-label-secondary"><i class="icon-base ri ri-wallet-3-line"></i></span>
                                <h6 class="mb-1">@L["No expenses recorded"]</h6>
                                <p class="text-body-secondary small mb-0">@(Model.CanAddExpense ? L["Add trainer fees, hall rental, catering and other costs in {0}, before or during the workshop.", currency] : L["This workshop is completed, so its expenses are finalised."])</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table">
                                    <thead><tr><th>@L["Expense"]</th><th>@L["Date"]</th><th class="text-end">@L["Amount ({0})", currency]</th><th>@L["Entered by"]</th>@if (canManage) { <th></th> }</tr></thead>
                                    <tbody class="table-border-bottom-0">
                                    @foreach (var e in Model.Expenses)
                                    {
                                        <tr class="@(highlight == e.Id.ToString() ? "row-highlight" : "")">
                                            <td>
                                                <div class="fw-medium text-heading">@(e.ExpenseCategory?.LocalName(UiText.Lang))</div>
                                                @if (!string.IsNullOrWhiteSpace(e.ExpenseCategory?.NameAr)) { <small class="text-body-secondary d-block" dir="rtl">@e.ExpenseCategory.NameAr</small> }
                                                @if (!string.IsNullOrWhiteSpace(e.Description)) { <small class="text-body-secondary">@e.Description</small> }
                                            </td>
                                            <td class="text-nowrap">@e.ExpenseDate.ToString("dd MMM yyyy")</td>
                                            <td class="text-end fw-medium text-nowrap">@e.Amount.ToString("N2")</td>
                                            <td class="small">@(e.UpdatedBy ?? e.CreatedBy)</td>
                                            @if (canManage)
                                            {
                                                <td class="text-end text-nowrap">
                                                    <a asp-controller="Expenses" asp-action="Edit" asp-route-id="@e.Id" class="btn btn-sm btn-icon btn-text-secondary rounded-pill" title="@L["Edit"]"><i class="icon-base ri ri-edit-box-line"></i></a>
                                                    <form asp-controller="Expenses" asp-action="Delete" asp-route-id="@e.Id" method="post" class="d-inline"
                                                          data-confirm="@L["{0} ({1}) will be removed from this workshop.", MoneyFormat.Format(e.Amount, currency), e.ExpenseCategory?.LocalName(UiText.Lang)]" data-confirm-title="@L["Delete this expense?"]" data-confirm-button="@L["Delete"]">
                                                        <button type="submit" class="btn btn-sm btn-icon btn-text-danger rounded-pill" title="@L["Delete"]" data-no-loading><i class="icon-base ri ri-delete-bin-7-line"></i></button>
                                                    </form>
                                                </td>
                                            }
                                        </tr>
                                    }
                                    </tbody>
                                    <tfoot><tr><th colspan="2">@L["Total"]</th><th class="text-end">@Model.TotalExpenses.ToString("N2")</th><th colspan="2"></th></tr></tfoot>
                                </table>
                            </div>
                        }
                    </div>
                }

                <!-- Payments (US-18) -->
                @if (showPayments)
                {
                    <div class="tab-pane fade @PaneCss("payments")" id="tab-payments" role="tabpanel">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 px-5 pt-4 pb-2">
                            <div>
                                <span class="text-body-secondary small">@L["Collected"]</span>
                                <span class="fw-semibold text-heading ms-1">@MoneyFormat.Format(fin.Collected, currency)</span>
                                <span class="text-body-secondary small ms-3">@L["Outstanding"]</span>
                                <span class="fw-semibold text-heading ms-1">@MoneyFormat.Format(fin.Outstanding, currency)</span>
                            </div>
                            @if (canCollect && Model.RegistrationCount > 0)
                            {
                                <a asp-controller="Collections" asp-action="Create" asp-route-workshopId="@w.Id" class="btn btn-sm btn-primary"><i class="icon-base ri ri-add-line me-1"></i>@L["Record payment"]</a>
                            }
                            else if (!Model.CanCollect)
                            {
                                <span class="badge bg-label-secondary"><i class="icon-base ri ri-lock-line me-1"></i>@L["Finalised — workshop completed"]</span>
                            }
                        </div>
                        @if (Model.Collections.Count == 0)
                        {
                            <div class="empty-state">
                                <span class="stat-icon bg-label-success"><i class="icon-base ri ri-hand-coin-line"></i></span>
                                <h6 class="mb-1">@L["No payments recorded"]</h6>
                                <p class="text-body-secondary small mb-0">@(Model.RegistrationCount == 0 ? L["Payments can be recorded once participants register."] : L["Record each fee payment received from a participant ({0} each).", MoneyFormat.Format(w.Fee!.Value, currency)])</p>
                            </div>
                        }
                        else
                        {
                            var canEditCollections = User.Can(Permissions.CollectionsManage) && Model.CanCollect;
                            <div class="table-responsive">
                                <table class="table">
                                    <thead><tr><th>@L["Participant"]</th><th>@L["Date"]</th><th>@L["Method"]</th><th class="text-end">@L["Amount ({0})", currency]</th><th>@L["Recorded by"]</th>@if (canEditCollections) { <th></th> }</tr></thead>
                                    <tbody class="table-border-bottom-0">
                                    @foreach (var c in Model.Collections)
                                    {
                                        <tr class="@(highlight == "c" + c.Id ? "row-highlight" : "")">
                                            <td>
                                                <div class="fw-medium text-heading">@c.Registration?.FullName</div>
                                                @if (!string.IsNullOrWhiteSpace(c.Reference)) { <small class="text-body-secondary">@L["Ref:"] @c.Reference</small> }
                                            </td>
                                            <td class="text-nowrap">@c.CollectedOn.ToString("dd MMM yyyy")</td>
                                            <td>@DisplayFormat.Label(c.Method)</td>
                                            <td class="text-end fw-medium text-nowrap">@c.Amount.ToString("N2")</td>
                                            <td class="small">@(c.UpdatedBy ?? c.CreatedBy)</td>
                                            @if (canEditCollections)
                                            {
                                                <td class="text-end text-nowrap">
                                                    <a asp-controller="Collections" asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-icon btn-text-secondary rounded-pill" title="@L["Edit"]"><i class="icon-base ri ri-edit-box-line"></i></a>
                                                    <form asp-controller="Collections" asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline"
                                                          data-confirm="@L["{0} from {1} will be removed.", MoneyFormat.Format(c.Amount, currency), c.Registration?.FullName]" data-confirm-title="@L["Delete this payment?"]" data-confirm-button="@L["Delete"]">
                                                        <button type="submit" class="btn btn-sm btn-icon btn-text-danger rounded-pill" title="@L["Delete"]" data-no-loading><i class="icon-base ri ri-delete-bin-7-line"></i></button>
                                                    </form>
                                                </td>
                                            }
                                        </tr>
                                    }
                                    </tbody>
                                    <tfoot><tr><th colspan="3">@L["Total collected"]</th><th class="text-end">@fin.Collected.ToString("N2")</th><th colspan="2"></th></tr></tfoot>
                                </table>
                            </div>
                        }
                    </div>
                }

                <!-- History -->
                <div class="tab-pane fade @PaneCss("history")" id="tab-history" role="tabpanel">
                    <div class="card-body">
                        <ul class="timeline-simple">
                            <li>
                                <div class="fw-medium">@L["Created"]</div>
                                <small class="text-body-secondary">@w.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm") · @(w.CreatedBy ?? "—")</small>
                            </li>
                            @foreach (var h in Model.History)
                            {
                                <li>
                                    @if (h.Action == WorkshopHistoryAction.StatusChanged)
                                    {
                                        var reversed = (int)h.ToStatus < (int)h.FromStatus;
                                        <div class="fw-medium">@(reversed ? L["Status reversed"] : L["Status changed"]): @UiText.Status(h.FromStatus) → @UiText.Status(h.ToStatus)</div>
                                    }
                                    else
                                    {
                                        <div class="fw-medium">@DisplayFormat.Label(h.Action)@(string.IsNullOrEmpty(h.Note) ? "" : ": " + h.Note)</div>
                                    }
                                    <small class="text-body-secondary">@h.ChangedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm") · @(h.ChangedBy ?? "—")</small>
                                </li>
                            }
                            @if (w.UpdatedAt.HasValue)
                            {
                                <li>
                                    <div class="fw-medium">@L["Last change"]</div>
                                    <small class="text-body-secondary">@w.UpdatedAt.Value.ToLocalTime().ToString("dd MMM yyyy, HH:mm") · @(w.UpdatedBy ?? "—")</small>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Side panels -->
    <div class="col-xl-4">
        <div class="card mb-6">
            <div class="card-header pb-2"><h5 class="mb-0">@L["Progress"]</h5></div>
            <div class="card-body">
                <div class="ws-steps mb-5">
                    @foreach (var s in Enum.GetValues<WorkshopStatus>())
                    {
                        var css = (int)w.Status > (int)s || w.Status == WorkshopStatus.Completed ? "done" : w.Status == s ? "current" : "";
                        <div class="ws-step @css">
                            <span class="dot"><i class="icon-base ri @(css == "done" ? "ri-check-line" : s == WorkshopStatus.Pending ? "ri-time-line" : s == WorkshopStatus.Ongoing ? "ri-play-line" : "ri-flag-2-line")"></i></span>
                            <span class="lbl">@UiText.Status(s)</span>
                        </div>
                    }
                </div>
                @if (Model.NextStatus.HasValue && User.Can(Permissions.WorkshopsChangeStatus))
                {
                    var next = Model.NextStatus.Value;
                    var isStart = next == WorkshopStatus.Ongoing;
                    <form asp-action="AdvanceStatus" method="post"
                          data-confirm="@(isStart ? L["The workshop will move to Ongoing."] : L["Registration will close, the workshop becomes read-only, and no more expenses or payments can be added."])"
                          data-confirm-title="@(isStart ? L["Start this workshop?"] : L["Mark as completed?"])"
                          data-confirm-button="@(isStart ? L["Start workshop"] : L["Complete workshop"])" data-confirm-style="primary">
                        <input type="hidden" name="id" value="@w.Id" />
                        <input type="hidden" name="target" value="@next" />
                        <button type="submit" class="btn btn-primary w-100" data-loading-text="@L["Updating…"]">
                            <i class="icon-base ri @(isStart ? "ri-play-circle-line" : "ri-checkbox-circle-line") me-1"></i>@(isStart ? L["Start workshop"] : L["Mark as completed"])
                        </button>
                    </form>
                }
                else if (!Model.NextStatus.HasValue)
                {
                    <p class="small text-body-secondary mb-0 text-center"><i class="icon-base ri ri-lock-line me-1"></i>@L["Completed workshops are read-only."]</p>
                }
                @if (Model.PreviousStatus.HasValue && User.Can(Permissions.WorkshopsReverseStatus))
                {
                    var prev = Model.PreviousStatus.Value;
                    <form asp-action="ReverseStatus" method="post" class="mt-2"
                          data-confirm="@L["The workshop goes back from {0} to {1}. Use this to correct a status changed by mistake; the change is recorded in History.", UiText.Status(w.Status), UiText.Status(prev)]"
                          data-confirm-title="@L["Reverse status to {0}?", UiText.Status(prev)]" data-confirm-button="@L["Reverse to {0}", UiText.Status(prev)]">
                        <input type="hidden" name="id" value="@w.Id" />
                        <input type="hidden" name="target" value="@prev" />
                        <button type="submit" class="btn btn-text-secondary btn-sm w-100" data-loading-text="@L["Updating…"]"><i class="icon-base ri ri-arrow-go-back-line me-1"></i>@L["Reverse to {0}", UiText.Status(prev)]</button>
                    </form>
                }
            </div>
        </div>

        @if (canSeeMoney || canSeeExpenses)
        {
            <div class="card mb-6">
                <div class="card-header pb-2 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">@L["Finance"]</h5>
                    <span class="badge bg-label-primary">@currency</span>
                </div>
                <div class="card-body">
                    @if (canSeeMoney)
                    {
                        <div class="d-flex justify-content-between mb-2"><span class="text-body-secondary">@L["Target ({0} seats × fee)", fin.Seats]</span><span class="fw-medium">@fin.TargetIncome.ToString("N2")</span></div>
                        <div class="d-flex justify-content-between mb-2"><span class="text-body-secondary">@L["Expected income"]</span><span class="fw-medium">@fin.ExpectedIncome.ToString("N2")</span></div>
                        <div class="d-flex justify-content-between mb-2"><span class="text-body-secondary">@L["Collected"]</span><span class="fw-medium text-success">@fin.Collected.ToString("N2")</span></div>
                        @if (fin.ExpectedIncome > 0)
                        {
                            <div class="progress mb-3" style="height: 6px" title="@L["{0}% collected", fin.CollectedPercent]"><div class="progress-bar bg-success" style="width: @fin.CollectedPercent%"></div></div>
                        }
                        <div class="d-flex justify-content-between mb-2"><span class="text-body-secondary">@L["Outstanding"]</span><span class="fw-medium text-warning">@fin.Outstanding.ToString("N2")</span></div>
                    }
                    @if (canSeeExpenses)
                    {
                        <div class="d-flex justify-content-between mb-2"><span class="text-body-secondary">@L["Total expenses"]</span><span class="fw-medium text-danger">@fin.TotalExpenses.ToString("N2")</span></div>
                    }
                    @if (canSeeMoney && canSeeExpenses)
                    {
                        <hr class="my-3" />
                        <div class="d-flex justify-content-between"><span class="fw-semibold">@L["Net profit"]</span><span class="fw-semibold @(fin.NetProfit < 0 ? "text-danger" : "text-success")">@MoneyFormat.Format(fin.NetProfit, currency)</span></div>
                        <div class="d-flex justify-content-between mt-1"><span class="text-body-secondary small">@L["Projected profit if full"]</span><span class="small fw-medium @(fin.ProjectedProfit < 0 ? "text-danger" : "")">@MoneyFormat.Format(fin.ProjectedProfit, currency)</span></div>
                        <small class="text-body-secondary d-block mt-2">@L["Net profit = collected − expenses."] @(w.IsFree ? L["Free workshop: no fee income."] : L["Fee: {0} per participant.", MoneyFormat.Format(w.Fee!.Value, currency)])</small>
                    }
                </div>
            </div>
        }

        <div class="card">
            <div class="card-header pb-2 d-flex justify-content-between align-items-center">
                <h5 class="mb-0">@L["Registration"]</h5>
                @if (w.RegistrationOpen) { <span class="badge bg-label-primary">@L["Open"]</span> } else { <span class="badge bg-label-secondary">@L["Closed"]</span> }
            </div>
            <div class="card-body">
                @if (w.RegistrationOpen && Model.RegistrationUrl != null)
                {
                    <p class="small text-body-secondary mb-3">@L["Share this link with students. They can switch between Arabic and English on the page."]</p>
                    <div class="input-group mb-3">
                        <input id="reg-link" type="text" class="form-control link-box" value="@Model.RegistrationUrl" readonly />
                        <button type="button" class="btn btn-primary" data-copy-target="#reg-link"><i class="icon-base ri ri-file-copy-line me-1"></i>@L["Copy"]</button>
                    </div>
                    <div class="d-flex gap-2 mb-4">
                        <a href="@Model.RegistrationUrl" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary flex-fill">@L["Preview (EN)"]</a>
                        <a href="@(Model.RegistrationUrl)?lang=ar" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary flex-fill">@L["معاينة (AR)"]</a>
                    </div>
                    @if (User.Can(Permissions.RegistrationsManage))
                    {
                        <form asp-action="CloseRegistration" method="post" class="mb-2"
                              data-confirm="@L["Students who open the link will see that registration is closed. You can reopen it later."]" data-confirm-title="@L["Close registration?"]" data-confirm-button="@L["Close registration"]">
                            <input type="hidden" name="id" value="@w.Id" />
                            <button type="submit" class="btn btn-outline-danger w-100" data-loading-text="@L["Closing…"]"><i class="icon-base ri ri-lock-line me-1"></i>@L["Close registration"]</button>
                        </form>
                        <form asp-action="RegenerateLink" method="post"
                              data-confirm="@L["The current link will stop working. Anyone you already sent it to will need the new one."]" data-confirm-title="@L["Create a new link?"]" data-confirm-button="@L["Create new link"]">
                            <input type="hidden" name="id" value="@w.Id" />
                            <button type="submit" class="btn btn-text-secondary btn-sm w-100">@L["Create a new link"]</button>
                        </form>
                    }
                }
                else if (w.Status == WorkshopStatus.Completed)
                {
                    <p class="small text-body-secondary mb-0">@L["Registration closed automatically when the workshop was completed."]</p>
                }
                else
                {
                    <p class="small text-body-secondary mb-4">@L["Open registration to get a public link students can use to apply."]</p>
                    @if (User.Can(Permissions.RegistrationsManage))
                    {
                        <form asp-action="OpenRegistration" method="post">
                            <input type="hidden" name="id" value="@w.Id" />
                            <button type="submit" class="btn btn-primary w-100" data-loading-text="@L["Opening…"]"><i class="icon-base ri ri-door-open-line me-1"></i>@L["Open registration"]</button>
                        </form>
                    }
                }
            </div>
        </div>
    </div>
</div>

@if (User.Can(Permissions.RegistrationsCancel) && w.Status != WorkshopStatus.Completed)
{
    <div class="modal fade" id="cancel-registration" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form asp-action="CancelRegistration" method="post" class="modal-content">
                <input type="hidden" name="id" value="@w.Id" />
                <input type="hidden" name="registrationId" id="cancel-registration-id" />
                <div class="modal-header">
                    <h5 class="modal-title">@L["Cancel this registration?"] <small class="d-block text-body-secondary mt-1" id="cancel-registration-name"></small></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Close"]"></button>
                </div>
                <div class="modal-body">
                    <ul class="small text-body-secondary ps-4 mb-4">
                        <li>@L["The seat becomes available to others."]</li>
                        <li>@L["They stop counting in participants and fees."]</li>
                        <li>@L["They stay on the list as Cancelled and can't register for this workshop again."]</li>
                        <li>@L["You can undo this later."]</li>
                    </ul>
                    <div class="form-floating form-floating-outline">
                        <input name="reason" id="cancel-reason" class="form-control" maxlength="250" placeholder="@L["Reason"]" />
                        <label for="cancel-reason">@L["Reason (optional)"]</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@L["Keep registration"]</button>
                    <button type="submit" class="btn btn-danger" data-loading-text="@L["Cancelling…"]">@L["Cancel registration"]</button>
                </div>
            </form>
        </div>
    </div>
    <script>
        document.getElementById('cancel-registration')?.addEventListener('show.bs.modal', function (e) {
            var b = e.relatedTarget;
            document.getElementById('cancel-registration-id').value = b.getAttribute('data-registration-id');
            document.getElementById('cancel-registration-name').textContent = b.getAttribute('data-registration-name');
            document.getElementById('cancel-reason').value = '';
        });
    </script>
}
