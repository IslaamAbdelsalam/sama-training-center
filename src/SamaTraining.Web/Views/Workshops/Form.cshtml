@model WorkshopFormModel
@{
    ViewData["Title"] = Model.Id == 0 ? "New Workshop" : "Edit Workshop";
}
<div class="d-flex justify-content-between align-items-center mb-6">
    <h4 class="mb-0">@ViewData["Title"]</h4>
    @if (Model.Id != 0)
    {
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Back to workshop</a>
    }
</div>

<form asp-action="Save" method="post">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="row g-6">
        <div class="col-lg-8">
            <div class="card">
                <h5 class="card-header">Workshop details</h5>
                <div class="card-body">
                    <div class="form-floating form-floating-outline mb-5">
                        <input asp-for="Name" class="form-control" placeholder="Workshop name" autofocus />
                        <label asp-for="Name"></label>
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="form-floating form-floating-outline mb-5">
                        <textarea asp-for="Description" class="form-control" placeholder="Short description" style="height: 90px"></textarea>
                        <label asp-for="Description"></label>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                    <div class="form-floating form-floating-outline">
                        <textarea asp-for="Content" class="form-control" placeholder="Content / agenda" style="height: 220px"></textarea>
                        <label asp-for="Content"></label>
                        <div class="form-text">Topics, agenda, trainer, requirements. Shown to students on the registration page.</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card mb-6">
                <h5 class="card-header">Schedule</h5>
                <div class="card-body">
                    <div class="form-floating form-floating-outline mb-5">
                        <input asp-for="Date" type="date" class="form-control" />
                        <label asp-for="Date"></label>
                        <span asp-validation-for="Date" class="text-danger small"></span>
                    </div>
                    <div class="row g-4">
                        <div class="col-6">
                            <div class="form-floating form-floating-outline">
                                <input asp-for="StartTime" type="time" class="form-control" />
                                <label asp-for="StartTime"></label>
                            </div>
                            <span asp-validation-for="StartTime" class="text-danger small"></span>
                        </div>
                        <div class="col-6">
                            <div class="form-floating form-floating-outline">
                                <input asp-for="EndTime" type="time" class="form-control" />
                                <label asp-for="EndTime"></label>
                            </div>
                            <span asp-validation-for="EndTime" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <h5 class="card-header">Delivery</h5>
                <div class="card-body">
                    <div class="form-floating form-floating-outline mb-2">
                        <select id="Country" name="@(Model.CountryLocked ? "" : "Country")" class="form-select" @(Model.CountryLocked ? "disabled" : "")>
                            <option value="">Choose…</option>
                            @foreach (var c in AppOptions.Value.GetCountries())
                            {
                                <!option value="@c.Code" data-currency="@c.Currency" selected="@(Model.Country == c.Code)">@c.Name</!option>
                            }
                        </select>
                        <label for="Country">Country</label>
                    </div>
                    @if (Model.CountryLocked)
                    {
                        <input type="hidden" name="Country" value="@Model.Country" />
                    }
                    <div class="form-text mb-5">
                        Currency: <span class="badge bg-label-primary" id="currency-hint">—</span>
                        @if (Model.CountryLocked) { <span class="d-block mt-1">Locked because expenses are already recorded.</span> }
                        else { <span class="d-block mt-1">All expenses for this workshop use this currency.</span> }
                    </div>
                    <span asp-validation-for="Country" class="text-danger small d-block mb-3"></span>
                    <div class="form-floating form-floating-outline mb-5">
                        <select asp-for="Type" class="form-select" asp-items="Html.GetEnumSelectList<WorkshopType>()">
                            <option value="">Choose…</option>
                        </select>
                        <label asp-for="Type"></label>
                        <span asp-validation-for="Type" class="text-danger small"></span>
                    </div>
                    <div id="hall-group" class="form-floating form-floating-outline mb-5">
                        <select asp-for="HallId" class="form-select" asp-items="Model.Halls">
                            <option value="">Choose a hall…</option>
                        </select>
                        <label asp-for="HallId"></label>
                        <span asp-validation-for="HallId" class="text-danger small"></span>
                    </div>
                    <div id="link-group" class="form-floating form-floating-outline mb-5">
                        <input asp-for="MeetingLink" class="form-control" placeholder="https://" />
                        <label asp-for="MeetingLink"></label>
                        <span asp-validation-for="MeetingLink" class="text-danger small"></span>
                    </div>
                    <div class="form-floating form-floating-outline">
                        <input asp-for="Capacity" class="form-control" placeholder="Capacity" />
                        <label asp-for="Capacity"></label>
                        <span asp-validation-for="Capacity" class="text-danger small"></span>
                        <div class="form-text">Registration stops when this number is reached. Leave empty for no limit.</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12">
            <button type="submit" class="btn btn-primary me-2"><i class="icon-base ri ri-save-line me-1"></i>@(Model.Id == 0 ? "Create workshop" : "Save changes")</button>
            @if (Model.Id == 0)
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            }
            else
            {
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
            }
        </div>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
