@model DashboardViewModel
@{
    ViewData["Title"] = L["Dashboard"];
    var name = User.FindFirst("full_name")?.Value ?? User.Identity?.Name;
    var settings = AppOptions.Value;
}

<div class="row g-6">
    <div class="col-12">
        <div class="card bg-primary text-white">
            <div class="card-body d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-4">
                <div>
                    <h4 class="text-white mb-1">@L["Welcome back, {0}", name]</h4>
                    <p class="mb-0 opacity-75">@L["Here is what is happening at the training center today, {0}.", DateTime.Today.ToString("dddd, d MMMM yyyy", DisplayFormat.Culture(UiText.Lang))]</p>
                </div>
                @if (User.Can(Permissions.WorkshopsManage))
                {
                    <a asp-controller="Workshops" asp-action="Create" class="btn btn-light text-primary">
                        <i class="icon-base ri ri-add-line me-1"></i>@L["New workshop"]
                    </a>
                }
            </div>
        </div>
    </div>

    @* Counts only (no money) — safe to show across both countries. *@
    @{
        var stats = new List<(string Label, string Value, string Icon, string Color, WorkshopStatus? Filter)>
        {
            ("Pending", Model.Pending.ToString(), "ri-time-line", "warning", WorkshopStatus.Pending),
            ("Ongoing", Model.Ongoing.ToString(), "ri-play-circle-line", "info", WorkshopStatus.Ongoing),
            ("Completed", Model.Completed.ToString(), "ri-checkbox-circle-line", "success", WorkshopStatus.Completed),
            ("Registrations", Model.TotalRegistrations.ToString("N0"), "ri-user-add-line", "primary", null),
        };
    }
    @foreach (var s in stats)
    {
        <div class="col-sm-6 col-lg-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <span class="stat-icon bg-label-@s.Color"><i class="icon-base ri @s.Icon"></i></span>
                        @if (s.Filter.HasValue)
                        {
                            <a asp-controller="Workshops" asp-action="Index" asp-route-Status="@s.Filter" class="small">@L["View"]</a>
                        }
                    </div>
                    <h4 class="mb-0">@s.Value</h4>
                    <p class="mb-0 text-body-secondary">@s.Label</p>
                </div>
            </div>
        </div>
    }

    <!-- Grouped by currency: each block adds up only its own currency's workshops. No conversion. -->
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-end mb-1">
            <h5 class="mb-0">@L["By currency"]</h5>
            <small class="text-body-secondary">@L["Each currency is totalled separately, as entered. Amounts are not converted."]</small>
        </div>
    </div>
    @foreach (var c in Model.Currencies)
    {
        <div class="col-lg-6">
            <div class="card h-100 currency-card">
                <div class="card-header d-flex justify-content-between align-items-center pb-3">
                    <div class="d-flex align-items-center gap-3">
                        <span class="currency-code">@c.Currency</span>
                        <div>
                            <h5 class="mb-0">@L[c.CountryName]</h5>
                            <small class="text-body-secondary">@L["{0} workshops · {1} participants · {2} completed", c.Workshops, c.Students.ToString("N0"), c.Completed]</small>
                        </div>
                    </div>
                    @{ var country = settings.GetCountries().FirstOrDefault(x => x.Currency == c.Currency); }
                    @if (country != null)
                    {
                        <a asp-controller="Workshops" asp-action="Index" asp-route-Country="@country.Code" class="btn btn-sm btn-outline-primary">@L["Workshops"]</a>
                    }
                </div>
                <div class="card-body d-flex flex-column">
                    @{ var f = c.Finance; }
                    @if (Model.ShowIncome && Model.ShowExpenses)
                    {
                        <div class="small text-body-secondary mb-1">@L["Net profit"]</div>
                        <div class="cc-profit @(f.NetProfit < 0 ? "neg" : "")">@f.NetProfit.ToString("N2") <span>@c.Currency</span></div>
                        <div class="cc-sub mb-5">@L["Collected"] <b>@f.Collected.ToString("N2")</b> − @L["Expenses"] <b>@f.TotalExpenses.ToString("N2")</b></div>
                    }
                    else if (Model.ShowIncome)
                    {
                        <div class="small text-body-secondary mb-1">@L["Collected"]</div>
                        <div class="cc-profit">@f.Collected.ToString("N2") <span>@c.Currency</span></div>
                        <div class="cc-sub mb-5">@L["From registration fees"]</div>
                    }
                    else if (Model.ShowExpenses)
                    {
                        <div class="small text-body-secondary mb-1">@L["Total expenses"]</div>
                        <div class="cc-profit neutral">@f.TotalExpenses.ToString("N2") <span>@c.Currency</span></div>
                        <div class="cc-sub mb-5">@L["Across {0} workshops", c.Workshops]</div>
                    }

                    @if (Model.ShowIncome)
                    {
                        <div class="d-flex justify-content-between small mb-1">
                            <span class="text-body-secondary">@L["Fee collection"]</span>
                            <span class="fw-semibold">@(f.ExpectedIncome > 0 ? f.CollectedPercent + "%" : "—")</span>
                        </div>
                        <div class="progress mb-2" style="height: 8px"><div class="progress-bar bg-success" style="width: @f.CollectedPercent%"></div></div>
                        <div class="cc-sub mb-3">@Html.Raw(L["<b>{0}</b> of <b>{1}</b> expected · <b class=\"text-warning\">{2}</b> outstanding", f.Collected.ToString("N2"), f.ExpectedIncome.ToString("N2"), f.Outstanding.ToString("N2")])</div>

                        <div class="cc-target mb-5">
                            <div>
                                <small>@L["Target if all {0} seats fill", f.Seats.ToString("N0")]</small>
                                <strong>@f.TargetIncome.ToString("N2")</strong>
                            </div>
                            @if (Model.ShowExpenses)
                            {
                                <div class="text-end">
                                    <small>@L["Projected profit"]</small>
                                    <strong class="@(f.ProjectedProfit < 0 ? "text-danger" : "text-success")">@f.ProjectedProfit.ToString("N2")</strong>
                                </div>
                            }
                            <div class="text-end">
                                <small>@L["Seats filled"]</small>
                                <strong>@f.FillPercent%</strong>
                            </div>
                        </div>
                    }

                    @if (Model.ShowExpenses)
                    {
                        <div class="cc-foot mt-auto">
                            <span>@L["This month"] <b>@c.ExpensesThisMonth.ToString("N2")</b></span>
                            <span>@L["Cost / participant"] <b>@(c.CostPerStudent.HasValue ? c.CostPerStudent.Value.ToString("N2") : "—")</b></span>
                            <span>@L["Top expense"] <b>@(c.TopCategory ?? "—")</b></span>
                        </div>
                    }
                    else if (!Model.ShowIncome)
                    {
                        <div class="row g-3">
                            <div class="col-4"><div class="report-mini"><strong>@c.Pending</strong><span>@L["Pending"]</span></div></div>
                            <div class="col-4"><div class="report-mini"><strong>@c.Ongoing</strong><span>@L["Ongoing"]</span></div></div>
                            <div class="col-4"><div class="report-mini"><strong>@c.Completed</strong><span>@L["Completed"]</span></div></div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-0">@L["Upcoming and running workshops"]</h5>
                    <small class="text-body-secondary">@L["{0} workshops currently accepting registrations", Model.OpenRegistrations]</small>
                </div>
                <a asp-controller="Workshops" asp-action="Index" class="btn btn-sm btn-outline-primary">@L["All workshops"]</a>
            </div>
            <div class="table-responsive">
                <table class="table">
                    <thead>
                    <tr>
                        <th>@L["Workshop"]</th>
                        <th>@L["Date"]</th>
                        <th>@L["Country"]</th>
                        <th>@L["Status"]</th>
                        <th>@L["Registration"]</th>
                        @if (Model.ShowExpenses) { <th class="text-end">@L["Expenses"]</th> }
                    </tr>
                    </thead>
                    <tbody class="table-border-bottom-0">
                    @if (Model.Upcoming.Count == 0)
                    {
                        <tr><td colspan="6" class="text-center text-body-secondary py-6">@L["No upcoming workshops yet."]</td></tr>
                    }
                    @foreach (var w in Model.Upcoming)
                    {
                        <tr>
                            <td>
                                <a asp-controller="Workshops" asp-action="Details" asp-route-id="@w.Id" class="fw-medium">@UiText.Pick(w.Name, w.NameAr)</a>
                                <small class="d-block text-body-secondary">@(w.Type == WorkshopType.Online ? L["Online"] : (w.Hall != null ? w.Hall.LocalName(UiText.Lang) : L["On-site"]))</small>
                            </td>
                            <td class="text-nowrap">@DisplayFormat.ShortDates(w.StartDateTime, w.EndDateTime) <small class="text-body-secondary d-block">@DisplayFormat.Hours(w)@(w.IsMultiDay ? " " + L["daily"] : "")</small></td>
                            <td>@L[settings.CountryName(w.Country)] <span class="badge bg-label-secondary ms-1">@w.CurrencyCode</span></td>
                            <td><partial name="_StatusBadge" model="w.Status" /></td>
                            <td>
                                @if (w.RegistrationOpen)
                                {
                                    <span class="badge bg-label-primary">@L["Open"]</span>
                                }
                                else
                                {
                                    <span class="badge bg-label-secondary">@L["Closed"]</span>
                                }
                            </td>
                            @if (Model.ShowExpenses)
                            {
                                <td class="text-end text-nowrap">@MoneyFormat.Format(Model.UpcomingExpenses.GetValueOrDefault(w.Id), w.CurrencyCode)</td>
                            }
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
