@model List<Hall>
@{
    ViewData["Title"] = L["Halls & Locations"];
    var uses = (Dictionary<int, int>)ViewBag.Uses;
    var highlight = TempData["Highlight"] as string;
}
<div class="d-flex justify-content-between align-items-center mb-6">
    <div>
        <h4 class="mb-1">@L["Halls & Locations"]</h4>
        <p class="mb-0 text-body-secondary">@L["Places available for on-site workshops."]</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="icon-base ri ri-add-line me-1"></i>@L["Add hall"]</a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table">
            <thead>
            <tr><th>@L["Name"]</th><th>@L["Location"]</th><th>@L["Capacity"]</th><th>@L["Used by"]</th><th>@L["Status"]</th><th class="text-end">@L["Actions"]</th></tr>
            </thead>
            <tbody class="table-border-bottom-0">
            @if (Model.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-body-secondary py-6">@L["No halls yet."]</td></tr>
            }
            @foreach (var h in Model)
            {
                var used = uses.GetValueOrDefault(h.Id);
                <tr class="@(highlight == h.Id.ToString() ? "row-highlight" : "")">
                    <td><div class="fw-medium text-heading">@h.Name</div>@if (!string.IsNullOrWhiteSpace(h.NameAr)) { <small class="text-body-secondary" dir="rtl">@h.NameAr</small> } else { <small class="text-warning">@L["Arabic name missing"]</small> }</td>
                    <td><div>@h.Location</div>@if (!string.IsNullOrWhiteSpace(h.LocationAr)) { <small class="text-body-secondary" dir="rtl">@h.LocationAr</small> }</td>
                    <td>@(h.Capacity?.ToString() ?? "—")</td>
                    <td>@L["{0} workshops", used]</td>
                    <td>
                        @if (h.IsActive) { <span class="badge bg-label-success">@L["Active"]</span> }
                        else { <span class="badge bg-label-secondary">@L["Inactive"]</span> }
                    </td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Edit" asp-route-id="@h.Id" data-row-link class="btn btn-sm btn-icon btn-text-secondary rounded-pill" title="@L["Edit"]"><i class="icon-base ri ri-edit-box-line"></i></a>
                        @if (used == 0)
                        {
                            <form asp-action="Delete" asp-route-id="@h.Id" method="post" class="d-inline" data-confirm="@L["\"{0}\" will be removed from the halls list.", h.Name]" data-confirm-title="@L["Delete this hall?"]" data-confirm-button="@L["Delete"]">
                                <button type="submit" class="btn btn-sm btn-icon btn-text-danger rounded-pill" title="@L["Delete"]" data-no-loading><i class="icon-base ri ri-delete-bin-7-line"></i></button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
