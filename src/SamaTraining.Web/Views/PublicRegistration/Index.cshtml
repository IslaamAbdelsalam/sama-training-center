@model PublicRegistrationViewModel
@inject PublicText T
@inject PhoneNumberService Phones
@{
    Layout = null;
    ViewData["PublicPage"] = true;
    ViewData["NeedsArabicFont"] = true;
    var l = Model.Lang;
    var isAr = l == "ar";
    var other = isAr ? "en" : "ar";
    var w = Model.Workshop;
    var country = w != null ? AppOptions.Value.FindCountry(w.Country) : null;
    var countryName = country == null ? null : (isAr ? country.NameAr : country.Name);
    string Err(string field) => ViewData.ModelState[field]?.Errors.FirstOrDefault()?.ErrorMessage ?? "";
    string Invalid(string field) => ViewData.ModelState[field]?.Errors.Count > 0 ? "is-invalid" : "";
    var actionUrl = Url.RouteUrl("public-registration", new { token = Model.Token, lang = l });
    var switchUrl = Url.RouteUrl("public-registration", new { token = Model.Token, lang = other });
    var wName = w?.LocalName(l);
    var wDescription = w?.LocalDescription(l);
    var wContent = w?.LocalContent(l);
    var pageTitle = T.Get("Title", l) + (w != null ? " — " + wName : "");
}
<!doctype html>
<html lang="@l" dir="@(isAr ? "rtl" : "ltr")" class="layout-wide" data-assets-path="/assets/">
<head>
    <partial name="_Head" />
    <title>@pageTitle | @AppOptions.Value.OrganizationName</title>
</head>
<body class="public-body">
<div class="public-wrapper py-6 py-md-8 px-4">
    <div class="public-card">
        <div class="d-flex justify-content-between align-items-center mb-5">
            <div class="public-brand">
                <span class="app-brand-logo sama-logo"><i class="icon-base ri ri-graduation-cap-fill"></i></span>
                <span>@AppOptions.Value.SystemName</span>
            </div>
            @if (Model.State != "success")
            {
                <a href="@switchUrl" class="btn btn-sm btn-outline-secondary lang-switch"><i class="icon-base ri ri-translate-2 me-1"></i>@T.Get("Language", l)</a>
            }
        </div>

        <div class="pub-panel">
            @if (w != null && Model.State is "form" or "full" or "closed")
            {
                <div class="p-5 p-md-6 pb-0">
                    <div class="pub-eyebrow mb-2">@T.Get("Title", l)</div>
                    <h3 class="mb-4 fw-semibold" dir="auto">@wName</h3>
                    <div class="pub-facts mb-2">
                        <div class="pub-fact">
                            <i class="icon-base ri ri-calendar-event-line"></i>
                            <div><small>@T.Get("Dates", l)</small><span>@DisplayFormat.Dates(w, l)</span></div>
                        </div>
                        <div class="pub-fact">
                            <i class="icon-base ri ri-time-line"></i>
                            <div><small>@T.Get("Time", l)</small><span><span dir="ltr">@DisplayFormat.Hours(w)</span>@(w.IsMultiDay ? " " + T.Get("Daily", l) : "")</span></div>
                        </div>
                        <div class="pub-fact">
                            <i class="icon-base ri @(w.Type == WorkshopType.Online ? "ri-global-line" : "ri-map-pin-line")"></i>
                            <div>
                                <small>@T.Get("Type", l)</small>
                                <span>@(w.Type == WorkshopType.Online ? T.Get("Online", l) : T.Get("OnSite", l))</span>
                            </div>
                        </div>
                        @if (w.Type == WorkshopType.OnSite)
                        {
                            var place = new[] { w.Hall?.LocalName(l), w.Hall?.LocalLocation(l), countryName }.Where(x => !string.IsNullOrWhiteSpace(x));
                            <div class="pub-fact">
                                <i class="icon-base ri ri-building-line"></i>
                                <div><small>@T.Get("Location", l)</small><span>@string.Join(isAr ? "، " : ", ", place)</span></div>
                            </div>
                        }
                        <div class="pub-fact pub-fee">
                            <i class="icon-base ri ri-price-tag-3-line"></i>
                            <div>
                                <small>@T.Get("Fee", l)</small>
                                @if (w.IsFree)
                                {
                                    <span class="badge bg-label-success">@T.Get("FreeNote", l)</span>
                                }
                                else
                                {
                                    <span class="fw-semibold" dir="auto">@DisplayFormat.Fee(w, l)</span>
                                }
                            </div>
                        </div>
                    </div>
                    @if (Model.State == "form" && (!string.IsNullOrWhiteSpace(wDescription) || !string.IsNullOrWhiteSpace(wContent)))
                    {
                        <div class="pub-about mt-4" dir="@(isAr ? "rtl" : "ltr")">
                            @if (!string.IsNullOrWhiteSpace(wDescription)) { <p class="mb-2 content-pre">@wDescription</p> }
                            @if (!string.IsNullOrWhiteSpace(wContent))
                            {
                                <details open>
                                    <summary>@T.Get("About", l)</summary>
                                    <div class="rich-text small mt-2">@RichText.ToHtml(wContent)</div>
                                </details>
                            }
                        </div>
                    }
                    <hr class="mt-5 mb-0" />
                </div>
            }

            <div class="p-5 p-md-6">
                @switch (Model.State)
                {
                    case "success":
                        <div class="pub-state">
                            <span class="pub-state-icon bg-label-success"><i class="icon-base ri ri-check-line"></i></span>
                            <h4 class="mb-2">@T.Get("SuccessTitle", l)</h4>
                            <p class="text-body-secondary mb-4">@T.Get("SuccessBody", l)</p>
                            @if (w != null)
                            {
                                <div class="pub-chips justify-content-center">
                                    <span class="pub-chip" dir="auto"><i class="icon-base ri ri-bookmark-line"></i>@wName</span>
                                    <span class="pub-chip"><i class="icon-base ri ri-calendar-event-line"></i>@DisplayFormat.Dates(w, l) · <span dir="ltr">@DisplayFormat.Hours(w)</span></span>
                                </div>
                            }
                        </div>
                        break;
                    case "closed":
                        <div class="pub-state">
                            <span class="pub-state-icon bg-label-secondary"><i class="icon-base ri ri-lock-line"></i></span>
                            <h4 class="mb-2">@T.Get("ClosedTitle", l)</h4>
                            <p class="text-body-secondary mb-0">@T.Get("ClosedBody", l)</p>
                        </div>
                        break;
                    case "full":
                        <div class="pub-state">
                            <span class="pub-state-icon bg-label-warning"><i class="icon-base ri ri-group-line"></i></span>
                            <h4 class="mb-2">@T.Get("FullTitle", l)</h4>
                            <p class="text-body-secondary mb-0">@T.Get("FullBody", l)</p>
                        </div>
                        break;
                    case "notfound":
                        <div class="pub-state">
                            <span class="pub-state-icon bg-label-danger"><i class="icon-base ri ri-link-unlink"></i></span>
                            <h4 class="mb-2">@T.Get("NotFoundTitle", l)</h4>
                            <p class="text-body-secondary mb-0">@T.Get("NotFoundBody", l)</p>
                        </div>
                        break;
                    default:
                        <h5 class="mb-1">@T.Get("FormTitle", l)</h5>
                        <p class="text-body-secondary mb-5 small">@T.Get("Subtitle", l)</p>
                        if (Model.Error != null)
                        {
                            <div class="alert alert-warning d-flex align-items-center gap-2" role="alert">
                                <i class="icon-base ri ri-information-line"></i><span>@Model.Error</span>
                            </div>
                        }
                        <form method="post" action="@actionUrl" novalidate>
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="fs" value="@Model.FormStamp" />
                            @* Robots fill in every field; people never see this one. *@
                            <div class="hp-field" aria-hidden="true">
                                <label for="website">Website</label>
                                <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" value="" />
                            </div>
                            <div class="mb-4">
                                <label class="form-label" for="FullName">@T.Get("FullName", l)</label>
                                <input id="FullName" name="FullName" value="@Model.Form.FullName" class="form-control @Invalid("FullName")" maxlength="150" autocomplete="name" dir="auto" placeholder="@T.Get("FullNameHint", l)" required />
                                <div class="invalid-feedback">@Err("FullName")</div>
                            </div>
                            <div class="mb-4">
                                <label class="form-label" for="Email">@T.Get("Email", l)</label>
                                <input id="Email" name="Email" type="email" value="@Model.Form.Email" class="form-control @Invalid("Email")" maxlength="256" autocomplete="email" dir="ltr" placeholder="name@example.com" required />
                                <div class="invalid-feedback">@Err("Email")</div>
                            </div>
                            <div class="mb-4">
                                <label class="form-label" for="Phone">@T.Get("Phone", l)</label>
                                <div class="input-group has-validation phone-group" dir="ltr">
                                    <span class="input-group-text phone-prefix" aria-hidden="true">00</span>
                                    <input id="Phone" name="Phone" type="tel" inputmode="numeric" value="@PhoneNumberService.Clean(Model.Form.Phone)"
                                           class="form-control @Invalid("Phone")" maxlength="15" autocomplete="tel" dir="ltr"
                                           placeholder="@(w?.Country == "EG" ? "201001234567" : "249912345678")" aria-describedby="phone-help" required
                                           data-phone-countries="@System.Text.Json.JsonSerializer.Serialize(Phones.Countries.Select(c => new { c = c.DialCode, n = isAr ? c.NameAr : c.Name, d = c.Digits }))" />
                                    <div class="invalid-feedback">@Err("Phone")</div>
                                </div>
                                <div id="phone-help" class="form-text" data-help-default="@T.Get("PhoneHint", l)" data-ok-text="@(isAr ? "✓ {0}، رقم صحيح" : "✓ {0} number, looks right")" data-need-text="@(isAr ? "{0}: {1} أرقام بعد {2} — باقي {3}" : "{0}: {1} digits after {2} — {3} to go")" data-over-text="@(isAr ? "{0}: {1} أرقام فقط بعد {2}" : "{0}: only {1} digits after {2}")">@T.Get("PhoneHint", l)</div>
                            </div>
                            <div class="mb-4">
                                <label class="form-label" for="Organization">@T.Get("Organization", l) <span class="text-body-secondary fw-normal small">@T.Get("Optional", l)</span></label>
                                <input id="Organization" name="Organization" value="@Model.Form.Organization" class="form-control" maxlength="150" dir="auto" />
                            </div>
                            <div class="mb-6">
                                <label class="form-label" for="Notes">@T.Get("Notes", l) <span class="text-body-secondary fw-normal small">@T.Get("Optional", l)</span></label>
                                <textarea id="Notes" name="Notes" class="form-control" rows="2" maxlength="500" dir="auto">@Model.Form.Notes</textarea>
                            </div>
                            <button type="submit" class="btn btn-primary btn-lg w-100" data-loading-text="@T.Get("Sending", l)">@T.Get("Submit", l)</button>
                            <p class="text-center small text-body-secondary mt-3 mb-0"><i class="icon-base ri ri-shield-check-line me-1"></i>@T.Get("Privacy", l)</p>
                        </form>
                        break;
                }
            </div>
        </div>
        <p class="text-center pub-footer mt-5 mb-0">&copy; @DateTime.Now.Year @AppOptions.Value.OrganizationName</p>
    </div>
</div>
<script src="~/assets/vendor/libs/jquery/jquery.js" asp-append-version="true"></script>
<script src="~/assets/vendor/js/bootstrap.js" asp-append-version="true"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
