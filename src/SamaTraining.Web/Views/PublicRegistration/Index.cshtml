@model PublicRegistrationViewModel
@inject PublicText T
@{
    Layout = null;
    var l = Model.Lang;
    var isAr = l == "ar";
    var other = isAr ? "en" : "ar";
    var w = Model.Workshop;
    string Err(string field) => ViewData.ModelState[field]?.Errors.FirstOrDefault()?.ErrorMessage ?? "";
    string Invalid(string field) => ViewData.ModelState[field]?.Errors.Count > 0 ? "is-invalid" : "";
    var actionUrl = Url.RouteUrl("public-registration", new { token = Model.Token, lang = l });
    var switchUrl = Url.RouteUrl("public-registration", new { token = Model.Token, lang = other });
}
<!doctype html>
<html lang="@l" dir="@(isAr ? "rtl" : "ltr")" class="layout-wide" data-assets-path="/assets/">
<head>
    <partial name="_Head" />
    <title>@T.Get("Title", l)@(w != null ? " — " + w.Name : "") | @AppOptions.Value.OrganizationName</title>
</head>
<body>
<div class="public-wrapper py-8 px-4">
    <div class="public-card">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="d-flex align-items-center gap-2">
                <span class="app-brand-logo sama-logo"><i class="icon-base ri ri-graduation-cap-fill"></i></span>
                <span class="fw-semibold text-heading">@AppOptions.Value.SystemName</span>
            </div>
            <a href="@switchUrl" class="btn btn-sm btn-outline-primary"><i class="icon-base ri ri-translate-2 me-1"></i>@T.Get("Language", l)</a>
        </div>

        <div class="card">
            @if (w != null)
            {
                <div class="public-header p-6">
                    <p class="mb-1 opacity-75">@T.Get("Title", l)</p>
                    <h4 class="mb-3" dir="auto">@w.Name</h4>
                    <div class="d-flex flex-wrap gap-4 small">
                        <span><i class="icon-base ri ri-calendar-line me-1"></i>@w.StartDateTime.ToString("dd/MM/yyyy")</span>
                        <span><i class="icon-base ri ri-time-line me-1"></i><span dir="ltr">@w.StartDateTime.ToString("HH:mm") – @w.EndDateTime.ToString("HH:mm")</span></span>
                        <span>
                            @if (w.Type == WorkshopType.Online)
                            {
                                <i class="icon-base ri ri-global-line me-1"></i>@T.Get("Online", l)
                            }
                            else
                            {
                                <i class="icon-base ri ri-map-pin-line me-1"></i>@(w.Hall?.Name ?? T.Get("OnSite", l))
                            }
                        </span>
                        @if (Model.SeatsLeft.HasValue && Model.State == "form")
                        {
                            <span><i class="icon-base ri ri-user-line me-1"></i>@T.Get("SeatsLeft", l): @Model.SeatsLeft</span>
                        }
                    </div>
                </div>
            }

            <div class="card-body p-6">
                @switch (Model.State)
                {
                    case "success":
                        <div class="text-center py-6">
                            <span class="stat-icon bg-label-success mb-4" style="width:64px;height:64px;font-size:2rem"><i class="icon-base ri ri-checkbox-circle-line"></i></span>
                            <h4 class="mb-2">@T.Get("SuccessTitle", l)</h4>
                            <p class="mb-0">@T.Get("SuccessBody", l)</p>
                        </div>
                        break;
                    case "closed":
                        <div class="text-center py-6">
                            <span class="stat-icon bg-label-secondary mb-4" style="width:64px;height:64px;font-size:2rem"><i class="icon-base ri ri-lock-line"></i></span>
                            <h4 class="mb-2">@T.Get("ClosedTitle", l)</h4>
                            <p class="mb-0">@T.Get("ClosedBody", l)</p>
                        </div>
                        break;
                    case "full":
                        <div class="text-center py-6">
                            <span class="stat-icon bg-label-warning mb-4" style="width:64px;height:64px;font-size:2rem"><i class="icon-base ri ri-group-line"></i></span>
                            <h4 class="mb-2">@T.Get("FullTitle", l)</h4>
                            <p class="mb-0">@T.Get("FullBody", l)</p>
                        </div>
                        break;
                    case "notfound":
                        <div class="text-center py-6">
                            <span class="stat-icon bg-label-danger mb-4" style="width:64px;height:64px;font-size:2rem"><i class="icon-base ri ri-link-unlink"></i></span>
                            <h4 class="mb-2">@T.Get("NotFoundTitle", l)</h4>
                            <p class="mb-0">@T.Get("NotFoundBody", l)</p>
                        </div>
                        break;
                    default:
                        if (!string.IsNullOrWhiteSpace(w?.Description) || !string.IsNullOrWhiteSpace(w?.Content))
                        {
                            <h6 class="mb-2">@T.Get("About", l)</h6>
                            <div dir="auto" class="mb-6">
                                @if (!string.IsNullOrWhiteSpace(w?.Description)) { <p class="content-pre">@w!.Description</p> }
                                @if (!string.IsNullOrWhiteSpace(w?.Content)) { <p class="content-pre small text-body-secondary mb-0">@w!.Content</p> }
                            </div>
                            <hr class="mb-6" />
                        }
                        <p class="mb-5">@T.Get("Subtitle", l)</p>
                        if (Model.Error != null)
                        {
                            <div class="alert alert-danger">@Model.Error</div>
                        }
                        <form method="post" action="@actionUrl" novalidate>
                            @Html.AntiForgeryToken()
                            <div class="mb-4">
                                <label class="form-label" for="FullName">@T.Get("FullName", l) <span class="text-danger">*</span></label>
                                <input id="FullName" name="FullName" value="@Model.Form.FullName" class="form-control @Invalid("FullName")" maxlength="150" autocomplete="name" dir="auto" required />
                                <div class="invalid-feedback">@Err("FullName")</div>
                            </div>
                            <div class="row g-4 mb-4">
                                <div class="col-md-6">
                                    <label class="form-label" for="Email">@T.Get("Email", l) <span class="text-danger">*</span></label>
                                    <input id="Email" name="Email" type="email" value="@Model.Form.Email" class="form-control @Invalid("Email")" maxlength="256" autocomplete="email" dir="ltr" required />
                                    <div class="invalid-feedback">@Err("Email")</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="Phone">@T.Get("Phone", l) <span class="text-danger">*</span></label>
                                    <input id="Phone" name="Phone" type="tel" value="@Model.Form.Phone" class="form-control @Invalid("Phone")" maxlength="20" autocomplete="tel" dir="ltr" required />
                                    <div class="invalid-feedback">@Err("Phone")</div>
                                </div>
                            </div>
                            <div class="mb-4">
                                <label class="form-label" for="Organization">@T.Get("Organization", l)</label>
                                <input id="Organization" name="Organization" value="@Model.Form.Organization" class="form-control" maxlength="150" dir="auto" />
                            </div>
                            <div class="mb-6">
                                <label class="form-label" for="Notes">@T.Get("Notes", l)</label>
                                <textarea id="Notes" name="Notes" class="form-control" rows="3" maxlength="500" dir="auto">@Model.Form.Notes</textarea>
                            </div>
                            <button type="submit" class="btn btn-primary btn-lg w-100">@T.Get("Submit", l)</button>
                        </form>
                        break;
                }
            </div>
        </div>
        <p class="text-center small text-body-secondary mt-4 mb-0">&copy; @DateTime.Now.Year @AppOptions.Value.OrganizationName</p>
    </div>
</div>
</body>
</html>
