@model ExpenseFormModel
@{
    ViewData["Title"] = Model.Id == 0 ? "Add Expense" : "Edit Expense";
}
<a asp-controller="Workshops" asp-action="Details" asp-route-id="@Model.WorkshopId" asp-route-tab="expenses" class="small"><i class="icon-base ri ri-arrow-left-line me-1"></i>@Model.WorkshopName</a>
<h4 class="mb-6 mt-2">@ViewData["Title"]</h4>

<div class="card" style="max-width: 640px">
    <div class="card-body">
        <form asp-action="Save" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="WorkshopId" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="form-floating form-floating-outline mb-5">
                <select asp-for="ExpenseCategoryId" class="form-select" asp-items="Model.Categories">
                    <option value="">Choose…</option>
                </select>
                <label asp-for="ExpenseCategoryId"></label>
                <span asp-validation-for="ExpenseCategoryId" class="text-danger small"></span>
            </div>
            <div class="row g-4 mb-5">
                <div class="col-sm-6">
                    <div class="input-group input-group-merge">
                        <div class="form-floating form-floating-outline">
                            <input asp-for="Amount" type="number" step="0.01" min="0.01" class="form-control" placeholder="0.00" />
                            <label asp-for="Amount"></label>
                        </div>
                        <span class="input-group-text">@Model.CurrencyCode</span>
                    </div>
                    <span asp-validation-for="Amount" class="text-danger small"></span>
                </div>
                <div class="col-sm-6">
                    <div class="form-floating form-floating-outline">
                        <input asp-for="ExpenseDate" type="date" class="form-control" />
                        <label asp-for="ExpenseDate"></label>
                    </div>
                    <span asp-validation-for="ExpenseDate" class="text-danger small"></span>
                </div>
            </div>
            <div class="form-floating form-floating-outline mb-6">
                <textarea asp-for="Description" class="form-control" placeholder="Description" style="height: 100px"></textarea>
                <label asp-for="Description"></label>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary me-2">@(Model.Id == 0 ? "Add expense" : "Save changes")</button>
            @if (Model.Id == 0)
            {
                <button type="submit" name="addAnother" value="true" class="btn btn-outline-primary me-2">Add &amp; add another</button>
            }
            <a asp-controller="Workshops" asp-action="Details" asp-route-id="@Model.WorkshopId" asp-route-tab="expenses" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
