@{
    ViewData["Title"] = "Password changed";
    Layout = "_AuthLayout";
}
<div class="text-center">
    <span class="stat-icon bg-label-success mx-auto mb-4" style="width:56px;height:56px;font-size:1.6rem"><i class="icon-base ri ri-shield-check-line"></i></span>
    <h4 class="mb-2">Your password has been reset</h4>
    <p class="mb-5">You can now sign in with your new password.</p>
    <a asp-action="Login" class="btn btn-primary w-100">Sign in</a>
</div>
