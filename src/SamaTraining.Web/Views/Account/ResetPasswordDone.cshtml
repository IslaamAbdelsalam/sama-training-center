@{
    ViewData["Title"] = L["Password changed"];
    Layout = "_AuthLayout";
}
<div class="text-center">
    <span class="stat-icon bg-label-success mx-auto mb-4" style="width:56px;height:56px;font-size:1.6rem"><i class="icon-base ri ri-shield-check-line"></i></span>
    <h4 class="mb-2">@L["Your password has been reset"]</h4>
    <p class="mb-5">@L["You can now sign in with your new password."]</p>
    <a asp-action="Login" class="btn btn-primary w-100">@L["Sign in"]</a>
</div>
