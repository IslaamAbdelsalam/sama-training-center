@model LoginViewModel
@{
    ViewData["Title"] = L["Sign in"];
    Layout = "_AuthLayout";
}
<h4 class="mb-1">@L["Sign in"]</h4>
<p class="mb-5">@L["Sign in with your staff account to manage workshops."]</p>

<form asp-action="Login" method="post" class="mb-5">
    <input type="hidden" asp-for="ReturnUrl" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small mb-4" role="alert"></div>

    <div class="form-floating form-floating-outline mb-5">
        <input asp-for="UserNameOrEmail" class="form-control" placeholder="@L["Username or email"]" autocomplete="username" autofocus />
        <label asp-for="UserNameOrEmail"></label>
        <span asp-validation-for="UserNameOrEmail" class="text-danger small"></span>
    </div>

    <div class="mb-5">
        <div class="form-password-toggle">
            <div class="input-group input-group-merge">
                <div class="form-floating form-floating-outline">
                    <input asp-for="Password" class="form-control" placeholder="@L["Password"]" autocomplete="current-password" />
                    <label asp-for="Password"></label>
                </div>
                <span class="input-group-text cursor-pointer"><i class="icon-base ri ri-eye-off-line icon-20px"></i></span>
            </div>
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>
    </div>

    <div class="mb-5 d-flex justify-content-between align-items-center">
        <div class="form-check mb-0">
            <input asp-for="RememberMe" class="form-check-input" />
            <label asp-for="RememberMe" class="form-check-label"></label>
        </div>
        <a asp-action="ForgotPassword" class="small">@L["Forgot password?"]</a>
    </div>

    <button class="btn btn-primary d-grid w-100" type="submit">@L["Sign in"]</button>
</form>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
