@model SetNewPasswordViewModel
@{
    ViewData["Title"] = L["Set a new password"];
    Layout = "_AuthLayout";
}
<h4 class="mb-1">@L["Set a new password"]</h4>
<p class="mb-5">@L["At least 8 characters, with upper and lower case letters, a number and a symbol."]</p>

<form asp-action="ResetPassword" method="post" class="mb-5">
    <input type="hidden" asp-for="UserId" />
    <input type="hidden" asp-for="Token" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small mb-4" role="alert"></div>
    <div class="form-floating form-floating-outline mb-5">
        <input asp-for="NewPassword" class="form-control" placeholder="@L["New password"]" autocomplete="new-password" autofocus />
        <label asp-for="NewPassword"></label>
        <span asp-validation-for="NewPassword" class="text-danger small"></span>
    </div>
    <div class="form-floating form-floating-outline mb-5">
        <input asp-for="ConfirmPassword" class="form-control" placeholder="@L["Confirm new password"]" autocomplete="new-password" />
        <label asp-for="ConfirmPassword"></label>
        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
    </div>
    <button class="btn btn-primary d-grid w-100" type="submit" data-loading-text="@L["Saving…"]">@L["Save new password"]</button>
</form>
<p class="text-center small mb-0"><a asp-action="ForgotPassword">@L["Request a new link"]</a></p>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
