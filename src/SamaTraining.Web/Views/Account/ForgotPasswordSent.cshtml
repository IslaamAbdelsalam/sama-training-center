@{
    ViewData["Title"] = L["Check your e-mail"];
    Layout = "_AuthLayout";
}
<div class="text-center">
    <span class="stat-icon bg-label-success mx-auto mb-4" style="width:56px;height:56px;font-size:1.6rem"><i class="icon-base ri ri-mail-send-line"></i></span>
    <h4 class="mb-2">@L["Check your e-mail"]</h4>
    <p class="mb-2">@L["We've sent a password reset link to"] <strong dir="ltr">@ViewBag.SentTo</strong>.</p>
    <p class="small text-body-secondary mb-5">@L["The link works once and expires in {0} minutes. Don't see it? Check your spam folder.", ViewBag.Minutes]</p>
    <a asp-action="Login" class="btn btn-primary w-100">@L["Back to sign in"]</a>
</div>
