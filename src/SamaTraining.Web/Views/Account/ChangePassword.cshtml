@model ChangePasswordViewModel
@{
    ViewData["Title"] = L["Change password"];
    Layout = Model.IsFirstLogin ? "_AuthLayout" : "_Layout";
}
@if (Model.IsFirstLogin)
{
    <h4 class="mb-1">@L["Set your own password"]</h4>
    <p class="mb-5">@L["For security, you must replace the temporary password before using the system."]</p>
}
else
{
    <h4 class="mb-1">@L["Change password"]</h4>
}

<div class="@(Model.IsFirstLogin ? "" : "card")">
    <div class="@(Model.IsFirstLogin ? "" : "card-body")" style="@(Model.IsFirstLogin ? "" : "max-width: 520px")">
        <form asp-action="ChangePassword" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small mb-4" role="alert"></div>

            <div class="form-floating form-floating-outline mb-4">
                <input asp-for="CurrentPassword" class="form-control" placeholder="@L["Current password"]" autocomplete="current-password" />
                <label asp-for="CurrentPassword"></label>
                <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
            </div>
            <div class="form-floating form-floating-outline mb-2">
                <input asp-for="NewPassword" class="form-control" placeholder="@L["New password"]" autocomplete="new-password" />
                <label asp-for="NewPassword"></label>
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>
            <p class="small text-body-secondary mb-4">@L["At least 8 characters, with an uppercase letter, a lowercase letter, a number and a symbol."]</p>
            <div class="form-floating form-floating-outline mb-5">
                <input asp-for="ConfirmPassword" class="form-control" placeholder="@L["Confirm new password"]" autocomplete="new-password" />
                <label asp-for="ConfirmPassword"></label>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary @(Model.IsFirstLogin ? "w-100" : "")">@L["Save password"]</button>
        </form>

        @if (Model.IsFirstLogin)
        {
            <form asp-action="Logout" method="post" class="mt-4 text-center">
                <button type="submit" class="btn btn-link btn-sm">@L["Sign out"]</button>
            </form>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
