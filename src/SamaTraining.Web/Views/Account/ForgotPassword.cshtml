@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
    Layout = "_AuthLayout";
}
<h4 class="mb-1">Forgot your password?</h4>
<p class="mb-5">Enter your username or email and we'll send you a link to set a new password.</p>

<form asp-action="ForgotPassword" method="post" class="mb-5">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small mb-4" role="alert"></div>
    <div class="form-floating form-floating-outline mb-5">
        <input asp-for="UserNameOrEmail" class="form-control" placeholder="Username or email" autocomplete="username" autofocus />
        <label asp-for="UserNameOrEmail"></label>
        <span asp-validation-for="UserNameOrEmail" class="text-danger small"></span>
    </div>
    <button class="btn btn-primary d-grid w-100" type="submit" data-loading-text="Sending…">Send reset link</button>
</form>

<p class="text-center small mb-0"><a asp-action="Login"><i class="icon-base ri ri-arrow-left-s-line"></i>Back to sign in</a></p>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
