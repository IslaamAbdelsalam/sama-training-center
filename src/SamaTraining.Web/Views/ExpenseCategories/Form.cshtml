@model ExpenseCategoryFormModel
@{
    ViewData["Title"] = Model.Id == 0 ? "Add Expense Category" : "Edit Expense Category";
}
<div class="mb-6">
    <a asp-action="Index" class="small d-inline-flex align-items-center mb-1"><i class="icon-base ri ri-arrow-left-line me-1"></i>Expense Categories</a>
    <h4 class="mb-0">@ViewData["Title"]</h4>
</div>

<div class="card">
    <form asp-action="Save" method="post" id="category-form">
        <div class="card-body">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="row g-5">
                <div class="col-md-6">
                    <div class="form-floating form-floating-outline">
                        <input asp-for="Name" class="form-control" placeholder="Name" dir="ltr" autofocus />
                        <label asp-for="Name"></label>
                    </div>
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-md-6" dir="rtl">
                    <div class="form-floating form-floating-outline">
                        <input asp-for="NameAr" class="form-control" placeholder="الاسم" />
                        <label asp-for="NameAr"></label>
                    </div>
                    <span asp-validation-for="NameAr" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <div class="form-floating form-floating-outline">
                        <input asp-for="Description" class="form-control" placeholder="Description" />
                        <label asp-for="Description"></label>
                    </div>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
                <div class="col-md-6 d-flex align-items-center">
                    <div class="form-check form-switch mb-0">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label"></label>
                        <div class="form-text">Inactive categories stay on old expenses but can't be picked for new ones.</div>
                    </div>
                </div>
            </div>
        </div>
    </form>
    <div class="card-footer d-flex flex-wrap justify-content-between align-items-center gap-3 border-top pt-5">
        <div>
            <button type="submit" form="category-form" class="btn btn-primary me-2"><i class="icon-base ri ri-save-line me-1"></i>Save</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
        @if (Model.Id != 0)
        {
            @if (Model.UsedBy == 0)
            {
                <form asp-action="Delete" asp-route-id="@Model.Id" asp-route-fromEdit="true" method="post"
                      data-confirm="&quot;@Model.Name&quot; will be permanently removed from the expense categories." data-confirm-title="Delete this category?" data-confirm-button="Delete">
                    <button type="submit" class="btn btn-outline-danger" data-loading-text="Deleting…"><i class="icon-base ri ri-delete-bin-7-line me-1"></i>Delete</button>
                </form>
            }
            else
            {
                <div class="d-flex align-items-center gap-2">
                    <span class="small text-body-secondary"><i class="icon-base ri ri-information-line me-1"></i>Used by @Model.UsedBy expense(s), so it can't be deleted. Switch it to inactive instead.</span>
                    <button type="button" class="btn btn-outline-danger" disabled><i class="icon-base ri ri-delete-bin-7-line me-1"></i>Delete</button>
                </div>
            }
        }
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
