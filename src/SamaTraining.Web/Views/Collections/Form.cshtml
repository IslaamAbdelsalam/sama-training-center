@model CollectionFormModel
@{
    ViewData["Title"] = Model.Id == 0 ? "Record Payment" : "Edit Payment";
}
<a asp-controller="Workshops" asp-action="Details" asp-route-id="@Model.WorkshopId" asp-route-tab="payments" class="small"><i class="icon-base ri ri-arrow-left-line me-1"></i>@Model.WorkshopName</a>
<h4 class="mb-1 mt-2">@ViewData["Title"]</h4>
<p class="text-body-secondary mb-6">Registration fee: <strong>@MoneyFormat.Format(Model.Fee, Model.CurrencyCode)</strong> per participant.</p>

<div class="card">
    <div class="card-body">
        <form asp-action="Save" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="WorkshopId" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="row g-5">
                <div class="col-md-6">
                    <div class="form-floating form-floating-outline">
                        <select asp-for="RegistrationId" class="form-select" asp-items="Model.Participants">
                            <option value="">Choose…</option>
                        </select>
                        <label asp-for="RegistrationId"></label>
                    </div>
                    <span asp-validation-for="RegistrationId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <div class="input-group input-group-merge">
                        <div class="form-floating form-floating-outline">
                            <input asp-for="Amount" type="number" step="0.01" min="0.01" class="form-control" placeholder="0.00" />
                            <label asp-for="Amount"></label>
                        </div>
                        <span class="input-group-text">@Model.CurrencyCode</span>
                    </div>
                    <span asp-validation-for="Amount" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <div class="form-floating form-floating-outline">
                        <input asp-for="CollectedOn" type="date" class="form-control" />
                        <label asp-for="CollectedOn"></label>
                    </div>
                    <span asp-validation-for="CollectedOn" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <div class="form-floating form-floating-outline">
                        <select asp-for="Method" class="form-select" asp-items="Html.GetEnumSelectList<PaymentMethod>()"></select>
                        <label asp-for="Method"></label>
                    </div>
                    <span asp-validation-for="Method" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <div class="form-floating form-floating-outline">
                        <input asp-for="Reference" class="form-control" placeholder="Reference" />
                        <label asp-for="Reference"></label>
                    </div>
                    <span asp-validation-for="Reference" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <div class="form-floating form-floating-outline">
                        <input asp-for="Notes" class="form-control" placeholder="Notes" />
                        <label asp-for="Notes"></label>
                    </div>
                    <span asp-validation-for="Notes" class="text-danger small"></span>
                </div>
            </div>

            <div class="mt-6">
                <button type="submit" class="btn btn-primary me-2"><i class="icon-base ri ri-save-line me-1"></i>@(Model.Id == 0 ? "Record payment" : "Save changes")</button>
                @if (Model.Id == 0)
                {
                    <button type="submit" name="addAnother" value="true" class="btn btn-outline-primary me-2">Record &amp; add another</button>
                }
                <a asp-controller="Workshops" asp-action="Details" asp-route-id="@Model.WorkshopId" asp-route-tab="payments" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
