@model ResetPasswordViewModel
@{
    ViewData["Title"] = L["Reset Password"];
}
<h4 class="mb-6">@L["Reset password for {0}", Model.UserName]</h4>

<div class="card" style="max-width: 560px">
    <div class="card-body">
        <form asp-action="ResetPassword" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="form-floating form-floating-outline mb-2">
                <input asp-for="NewPassword" class="form-control" placeholder="@L["New temporary password"]" autocomplete="new-password" autofocus />
                <label asp-for="NewPassword"></label>
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>
            <p class="small text-body-secondary mb-6">@L["The user will be asked to change this password at next login. Resetting also unlocks the account."]</p>
            <button type="submit" class="btn btn-primary me-2">@L["Set temporary password"]</button>
            <a asp-action="Index" class="btn btn-outline-secondary">@L["Cancel"]</a>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
