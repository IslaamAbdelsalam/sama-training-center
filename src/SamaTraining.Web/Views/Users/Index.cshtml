@model List<UserListItem>
@{
    ViewData["Title"] = "Users";
}
<div class="d-flex justify-content-between align-items-center mb-6">
    <div>
        <h4 class="mb-1">Users</h4>
        <p class="mb-0 text-body-secondary">Staff accounts that can sign in to the system.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="icon-base ri ri-user-add-line me-1"></i>Add user</a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table">
            <thead>
            <tr><th>User</th><th>Username</th><th>Roles</th><th>Status</th><th class="text-end">Actions</th></tr>
            </thead>
            <tbody class="table-border-bottom-0">
            @foreach (var u in Model)
            {
                var initials = string.Concat((string.IsNullOrWhiteSpace(u.FullName) ? u.UserName : u.FullName).Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));
                <tr>
                    <td>
                        <div class="d-flex align-items-center">
                            <div class="avatar avatar-sm me-3"><span class="avatar-initial rounded-circle bg-label-primary">@initials</span></div>
                            <div>
                                <div class="fw-medium text-heading">@u.FullName</div>
                                <small class="text-body-secondary">@u.Email</small>
                            </div>
                        </div>
                    </td>
                    <td>@u.UserName</td>
                    <td>
                        @foreach (var r in u.Roles)
                        {
                            <span class="badge bg-label-primary me-1">@r</span>
                        }
                    </td>
                    <td>
                        @if (!u.IsActive) { <span class="badge bg-label-secondary">Inactive</span> }
                        else if (u.IsLockedOut) { <span class="badge bg-label-danger">Locked</span> }
                        else { <span class="badge bg-label-success">Active</span> }
                    </td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-icon btn-text-secondary rounded-pill" title="Edit"><i class="icon-base ri ri-edit-box-line"></i></a>
                        <a asp-action="ResetPassword" asp-route-id="@u.Id" class="btn btn-sm btn-icon btn-text-secondary rounded-pill" title="Reset password"><i class="icon-base ri ri-key-2-line"></i></a>
                        @if (u.IsLockedOut)
                        {
                            <form asp-action="Unlock" asp-route-id="@u.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-icon btn-text-warning rounded-pill" title="Unlock"><i class="icon-base ri ri-lock-unlock-line"></i></button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
