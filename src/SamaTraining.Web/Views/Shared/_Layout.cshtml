@{
    var settings = AppOptions.Value;
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    string Active(params string[] names) => names.Contains(controller, StringComparer.OrdinalIgnoreCase) ? "active" : "";
    var fullName = User.FindFirst("full_name")?.Value ?? User.Identity?.Name;
    var initials = string.Concat((fullName ?? "U").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));
    var settingsOpen = Active("ExpenseCategories", "Halls") == "active" ? "active open" : "";
    var adminOpen = Active("Users", "Roles") == "active" ? "active open" : "";
}
<!doctype html>
<html lang="en" class="layout-menu-fixed layout-compact" data-assets-path="/assets/" data-template="vertical-menu-template-free">
<head>
    <partial name="_Head" />
    <title>@ViewData["Title"] | @settings.SystemName</title>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
<div class="layout-wrapper layout-content-navbar">
    <div class="layout-container">

        <!-- Menu -->
        <aside id="layout-menu" class="layout-menu menu-vertical menu bg-menu-theme">
            <div class="app-brand demo">
                <a asp-controller="Dashboard" asp-action="Index" class="app-brand-link">
                    <span class="app-brand-logo demo sama-logo"><i class="icon-base ri ri-graduation-cap-fill"></i></span>
                    <span class="app-brand-text demo menu-text fw-semibold ms-2 sama-brand">SAMA Training</span>
                </a>
                <a href="javascript:void(0);" class="layout-menu-toggle menu-link text-large ms-auto">
                    <i class="menu-toggle-icon d-xl-inline-block align-middle"></i>
                </a>
            </div>

            <div class="menu-inner-shadow"></div>

            <ul class="menu-inner py-1">
                @if (User.Can(Permissions.DashboardView))
                {
                    <li class="menu-item @Active("Dashboard")">
                        <a asp-controller="Dashboard" asp-action="Index" class="menu-link">
                            <i class="menu-icon icon-base ri ri-home-smile-line"></i>
                            <div>Dashboard</div>
                        </a>
                    </li>
                }

                @if (User.Can(Permissions.WorkshopsView))
                {
                    <li class="menu-header mt-5"><span class="menu-header-text">Training</span></li>
                    <li class="menu-item @Active("Workshops", "Expenses")">
                        <a asp-controller="Workshops" asp-action="Index" class="menu-link">
                            <i class="menu-icon icon-base ri ri-presentation-line"></i>
                            <div>Workshops</div>
                        </a>
                    </li>
                    @if (User.Can(Permissions.WorkshopsManage))
                    {
                        <li class="menu-item">
                            <a asp-controller="Workshops" asp-action="Create" class="menu-link">
                                <i class="menu-icon icon-base ri ri-add-circle-line"></i>
                                <div>New Workshop</div>
                            </a>
                        </li>
                    }
                }

                @if (User.Can(Permissions.SettingsManage))
                {
                    <li class="menu-header mt-5"><span class="menu-header-text">Settings</span></li>
                    <li class="menu-item @settingsOpen">
                        <a href="javascript:void(0);" class="menu-link menu-toggle">
                            <i class="menu-icon icon-base ri ri-settings-4-line"></i>
                            <div>Workshop Settings</div>
                        </a>
                        <ul class="menu-sub">
                            <li class="menu-item @Active("ExpenseCategories")">
                                <a asp-controller="ExpenseCategories" asp-action="Index" class="menu-link"><div>Expense Categories</div></a>
                            </li>
                            <li class="menu-item @Active("Halls")">
                                <a asp-controller="Halls" asp-action="Index" class="menu-link"><div>Halls &amp; Locations</div></a>
                            </li>
                        </ul>
                    </li>
                }

                @if (User.Can(Permissions.UsersManage))
                {
                    <li class="menu-header mt-5"><span class="menu-header-text">Administration</span></li>
                    <li class="menu-item @adminOpen">
                        <a href="javascript:void(0);" class="menu-link menu-toggle">
                            <i class="menu-icon icon-base ri ri-shield-user-line"></i>
                            <div>User Management</div>
                        </a>
                        <ul class="menu-sub">
                            <li class="menu-item @Active("Users")">
                                <a asp-controller="Users" asp-action="Index" class="menu-link"><div>Users</div></a>
                            </li>
                            <li class="menu-item @Active("Roles")">
                                <a asp-controller="Roles" asp-action="Index" class="menu-link"><div>Roles &amp; Permissions</div></a>
                            </li>
                        </ul>
                    </li>
                }
            </ul>
        </aside>
        <!-- / Menu -->

        <div class="layout-page">
            <!-- Navbar -->
            <nav class="layout-navbar container-xxl navbar-detached navbar navbar-expand-xl align-items-center bg-navbar-theme" id="layout-navbar">
                <div class="layout-menu-toggle navbar-nav align-items-xl-center me-4 me-xl-0 d-xl-none">
                    <a class="nav-item nav-link px-0 me-xl-6" href="javascript:void(0)">
                        <i class="icon-base ri ri-menu-line icon-md"></i>
                    </a>
                </div>

                <div class="navbar-nav-right d-flex align-items-center justify-content-end" id="navbar-collapse">
                    @if (User.Can(Permissions.WorkshopsView))
                    {
                        <form asp-controller="Workshops" asp-action="Index" method="get" class="navbar-nav align-items-center">
                            <div class="nav-item d-flex align-items-center">
                                <i class="icon-base ri ri-search-line icon-lg lh-0"></i>
                                <input type="text" name="Search" class="form-control border-0 shadow-none" placeholder="Search workshops..." aria-label="Search workshops" />
                            </div>
                        </form>
                    }

                    <ul class="navbar-nav flex-row align-items-center ms-md-auto">
                        <li class="nav-item navbar-dropdown dropdown-user dropdown">
                            <a class="nav-link dropdown-toggle hide-arrow p-0" href="javascript:void(0);" data-bs-toggle="dropdown">
                                <div class="avatar avatar-online">
                                    <span class="avatar-initial rounded-circle bg-label-primary">@initials</span>
                                </div>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <div class="dropdown-item">
                                        <div class="d-flex">
                                            <div class="flex-shrink-0 me-3">
                                                <div class="avatar avatar-online">
                                                    <span class="avatar-initial rounded-circle bg-label-primary">@initials</span>
                                                </div>
                                            </div>
                                            <div class="flex-grow-1">
                                                <h6 class="mb-0">@fullName</h6>
                                                <small class="text-body-secondary">@User.Identity?.Name</small>
                                            </div>
                                        </div>
                                    </div>
                                </li>
                                <li><div class="dropdown-divider my-1"></div></li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">
                                        <i class="icon-base ri ri-lock-password-line icon-md me-3"></i><span>Change Password</span>
                                    </a>
                                </li>
                                <li><div class="dropdown-divider my-1"></div></li>
                                <li>
                                    <div class="d-grid px-4 pt-2 pb-1">
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            <button type="submit" class="btn btn-danger d-flex w-100 justify-content-center">
                                                <small class="align-middle">Logout</small>
                                                <i class="icon-base ri ri-logout-box-r-line ms-2 icon-xs"></i>
                                            </button>
                                        </form>
                                    </div>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </nav>
            <!-- / Navbar -->

            <div class="content-wrapper">
                <div class="container-xxl flex-grow-1 container-p-y">
                    <partial name="_Flash" />
                    @RenderBody()
                </div>

                <footer class="content-footer footer bg-footer-theme">
                    <div class="container-xxl">
                        <div class="footer-container d-flex align-items-center justify-content-between py-4 flex-md-row flex-column">
                            <div class="mb-2 mb-md-0">&copy; @DateTime.Now.Year @settings.OrganizationName — @settings.SystemName</div>
                            <div class="text-body-secondary small">Phase One</div>
                        </div>
                    </div>
                </footer>

                <div class="content-backdrop fade"></div>
            </div>
        </div>
    </div>

    <div class="layout-overlay layout-menu-toggle"></div>
</div>

<partial name="_Scripts" />
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
