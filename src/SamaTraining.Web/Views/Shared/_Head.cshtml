@* Shared <head> content for every layout: Materio theme (green) + site styles. *@
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="robots" content="noindex, nofollow" />
<link rel="icon" type="image/svg+xml" href="~/assets/img/favicon/favicon.svg" asp-append-version="true" />
<link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48" href="~/assets/img/favicon/favicon.ico" asp-append-version="true" />
<link rel="apple-touch-icon" href="~/assets/img/favicon/apple-touch-icon.png" asp-append-version="true" />
<meta name="theme-color" content="#16a34a" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
@if (UiText.IsArabic || ViewData["NeedsArabicFont"] is true)
{
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Cairo:wght@400;600;700&display=swap" rel="stylesheet" />
}
else
{
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
}

<link rel="stylesheet" href="~/assets/vendor/fonts/iconify-icons.css" />
<link rel="stylesheet" href="~/assets/vendor/libs/node-waves/node-waves.css" />
@if (UiText.IsArabic && ViewData["PublicPage"] is not true)
{
    <link rel="stylesheet" href="~/assets/vendor/css/core.rtl.css" asp-append-version="true" />
}
else
{
    <link rel="stylesheet" href="~/assets/vendor/css/core.css" asp-append-version="true" />
}
<link rel="stylesheet" href="~/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.css" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

<script src="~/assets/vendor/js/helpers.js"></script>
<script src="~/assets/js/config.js"></script>
