@*
    Feedback after add / update / delete (set by AppController.Success/Error/Info)
    and a warning toast when a form comes back with validation errors.
*@
@{
    var kind = TempData["FlashKind"] as string;
    var title = TempData["FlashTitle"] as string;
    var message = TempData["FlashMessage"] as string;
    var invalidForm = ViewContext.HttpContext.Request.Method == "POST" && !ViewData.ModelState.IsValid;
    string Icon(string? k) => k switch
    {
        "success" => "ri-checkbox-circle-fill",
        "danger" => "ri-close-circle-fill",
        "warning" => "ri-error-warning-fill",
        _ => "ri-information-fill"
    };
}
<div class="toast-container position-fixed top-0 end-0 p-4 app-toasts" aria-live="polite">
    @if (!string.IsNullOrEmpty(title))
    {
        <div class="toast app-toast app-toast-@kind" role="status" data-bs-delay="5000">
            <div class="d-flex align-items-start gap-3 p-3">
                <i class="icon-base ri @Icon(kind) app-toast-icon"></i>
                <div class="flex-grow-1">
                    <div class="fw-semibold text-heading">@title</div>
                    @if (!string.IsNullOrEmpty(message))
                    {
                        <div class="small text-body-secondary mt-1">@message</div>
                    }
                </div>
                <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="app-toast-progress"></div>
        </div>
    }
    @if (invalidForm)
    {
        <div class="toast app-toast app-toast-warning" role="alert" data-bs-delay="6000">
            <div class="d-flex align-items-start gap-3 p-3">
                <i class="icon-base ri @Icon("warning") app-toast-icon"></i>
                <div class="flex-grow-1">
                    <div class="fw-semibold text-heading">Not saved yet</div>
                    <div class="small text-body-secondary mt-1">Please check the highlighted fields and try again.</div>
                </div>
                <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="app-toast-progress"></div>
        </div>
    }
</div>

<!-- Confirmation dialog used by forms with data-confirm="..." -->
<div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-body text-center pt-6 pb-4 px-5">
                <span class="confirm-icon mb-3"><i class="icon-base ri ri-error-warning-line"></i></span>
                <h5 class="mb-2" id="confirmTitle">Are you sure?</h5>
                <p class="mb-0 text-body-secondary small" id="confirmMessage"></p>
            </div>
            <div class="modal-footer justify-content-center border-0 pt-0 pb-5 gap-2">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmOk">Yes, continue</button>
            </div>
        </div>
    </div>
</div>
