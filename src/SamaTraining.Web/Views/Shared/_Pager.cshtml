@model PageLinks
@* Pager under every list: rows per page (10/25/50/100), "21–40 of 75", First / Previous / Next.
   Every filter in the address is kept; changing the page size goes back to the first page. *@
@{
    string Url(string? cursor, int? at, int? size = null)
    {
        var q = Context.Request.Query
            .Where(kv => kv.Key != Model.Param && kv.Key != Model.AtParam && kv.Key != "tab" && (size == null || kv.Key != Model.SizeParam))
            .ToDictionary(kv => kv.Key, kv => (string?)kv.Value.ToString());
        if (cursor != null) q[Model.Param] = cursor;
        if (at is > 0) q[Model.AtParam] = at.Value.ToString();
        if (size != null) q[Model.SizeParam] = size.Value.ToString();
        if (Model.Tab != null) q["tab"] = Model.Tab;
        return Context.Request.Path + QueryString.Create(q);
    }
    var from = Model.Shown == 0 ? 0 : Model.At + 1;
    var to = Model.At + Model.Shown;
}
@if (Model.Total > 0)
{
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 px-5 py-4 border-top pager">
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <label class="d-flex align-items-center gap-2 small text-body-secondary mb-0">
                @L["Rows per page"]
                <select class="form-select form-select-sm w-auto" data-page-size aria-label="@L["Rows per page"]">
                    @foreach (var n in Paging.Sizes)
                    {
                        <!option value="@Url(null, null, n)" selected="@(n == Model.Size)">@n</!option>
                    }
                </select>
            </label>
            <small class="text-body-secondary">@L["{0}–{1} of {2}", from, to, Model.Total]</small>
        </div>
        @if (Model.IsPaged || Model.Next != null)
        {
            <div class="d-flex gap-2">
                @if (Model.IsPaged)
                {
                    <a href="@Url(null, null)" class="btn btn-sm btn-outline-secondary" title="@L["First page"]"><i class="icon-base ri ri-arrow-go-back-line me-1"></i>@L["First page"]</a>
                    <a href="@Url(null, null)" class="btn btn-sm btn-outline-secondary" data-page-back title="@L["Previous page"]"><i class="icon-base ri ri-arrow-left-s-line me-1 pager-prev"></i>@L["Previous page"]</a>
                }
                @if (Model.Next != null)
                {
                    <a href="@Url(Model.Next, Model.At + Model.Shown)" class="btn btn-sm btn-primary">@L["Next page"]<i class="icon-base ri ri-arrow-left-s-line ms-1 pager-next"></i></a>
                }
                else
                {
                    <span class="btn btn-sm btn-primary disabled" aria-disabled="true">@L["Next page"]<i class="icon-base ri ri-arrow-left-s-line ms-1 pager-next"></i></span>
                }
            </div>
        }
    </div>
}
