@model List<(int Id, string Name, int Active, int Capacity)>
<li class="nav-item dropdown me-2 me-xl-1">
    <a class="nav-link btn btn-icon rounded-pill position-relative @(Model.Count > 0 ? "btn-text-danger" : "btn-text-secondary")" href="javascript:void(0);"
       data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" title="Alerts" id="capacity-alerts">
        <i class="icon-base ri @(Model.Count > 0 ? "ri-notification-badge-line" : "ri-notification-3-line") icon-22px"></i>
        @if (Model.Count > 0)
        {
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size:.65rem">@Model.Count</span>
        }
    </a>
    <div class="dropdown-menu dropdown-menu-end p-0" style="min-width: 320px">
        <div class="px-4 py-3 border-bottom d-flex justify-content-between align-items-center">
            <h6 class="mb-0">Alerts</h6>
            @if (Model.Count > 0) { <span class="badge bg-label-danger">@Model.Count need attention</span> }
        </div>
        @if (Model.Count == 0)
        {
            <div class="px-4 py-4 small text-body-secondary"><i class="icon-base ri ri-check-line me-1 text-success"></i>No workshop is over capacity.</div>
        }
        else
        {
            @foreach (var a in Model)
            {
                <a class="dropdown-item px-4 py-3 border-bottom d-flex gap-3 align-items-start" asp-controller="Workshops" asp-action="Details" asp-route-id="@a.Id" asp-route-tab="registrations">
                    <span class="stat-icon bg-label-danger flex-shrink-0" style="width:34px;height:34px;font-size:1rem"><i class="icon-base ri ri-error-warning-line"></i></span>
                    <span class="text-wrap">
                        <span class="fw-medium text-heading d-block">@a.Name</span>
                        <small class="text-danger">Over capacity: @a.Active participants for @a.Capacity seats (@(a.Active - a.Capacity) extra)</small>
                    </span>
                </a>
            }
        }
    </div>
</li>
