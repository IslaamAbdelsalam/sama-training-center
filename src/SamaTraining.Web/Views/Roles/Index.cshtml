@model List<RoleListItem>
@{
    ViewData["Title"] = "Roles & Permissions";
}
<div class="d-flex justify-content-between align-items-center mb-6">
    <div>
        <h4 class="mb-1">Roles &amp; Permissions</h4>
        <p class="mb-0 text-body-secondary">Each role grants a set of permissions. Users get the permissions of all their roles.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="icon-base ri ri-add-line me-1"></i>Add role</a>
</div>

<div class="row g-6">
    @foreach (var r in Model)
    {
        <div class="col-md-6 col-xl-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <span class="stat-icon bg-label-primary"><i class="icon-base ri @(r.Name == Roles.Administrator ? "ri-shield-star-line" : "ri-shield-user-line")"></i></span>
                        <span class="badge bg-label-secondary">@r.Users user(s)</span>
                    </div>
                    <h5 class="mb-1">@r.Name</h5>
                    <p class="text-body-secondary small mb-4">@r.Permissions of @Permissions.All.Count permissions</p>
                    <div class="d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary">Edit permissions</a>
                        @if (r.Name != Roles.Administrator && r.Users == 0)
                        {
                            <form asp-action="Delete" asp-route-id="@r.Id" method="post" data-confirm="Delete the role &quot;@r.Name&quot;?">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>
